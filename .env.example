# ─────────────────────────────────────────────────────────────
# Lot Agent — environment variables
# Copy to `.env` and fill in. Secrets live here; non-secret
# structure lives in config/default.json (override locally via
# config/local.json). Server throws on startup if PG_PASSWORD is missing.
# ─────────────────────────────────────────────────────────────

# LLM (text) — OpenAI-compatible. Default points at DeepSeek; any
# OpenAI-compatible endpoint works (OpenAI, DeepSeek, local vLLM, …).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenhub.todoucloud.com/v1
OPENAI_MODEL=deepseek-v4-flash

# LLM (text) — Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Which text provider the agent uses by default: openai | anthropic
LLM_DEFAULT=openai

# Master key for encrypting secrets at rest (tokenhub api keys, platform
# access tokens) with AES-256-GCM. 64 hex chars (32 bytes) — generate with:
#   openssl rand -hex 32
# A base64-encoded 32-byte key is also accepted. Leave empty and secrets are
# stored in PLAINTEXT (a one-time startup warning is logged); pre-existing
# plaintext rows keep working even after this is set — the read path detects
# the "enc:v1:" prefix and returns legacy values unchanged otherwise. REQUIRED
# in production. Keep as a secret — never commit a real value. Server and
# worker must use the SAME key (they decrypt/encrypt the same rows).
SECRET_MASTER_KEY=

# PostgreSQL (business data). Server throws if PG_PASSWORD is empty.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=lot

# Redis — BullMQ queue, generation cache, progress pub/sub
# Example dev value:
REDIS_URL=redis://:rag123456@localhost:6379
REDIS_PASSWORD=rag123456
# HTTP server
PORT=3000
# Allowed CORS origins for the web client (comma-separated)
CORS_ORIGIN=http://localhost:5173,https://aigc.todoucloud.com
# Optional: absolute base for static file URLs (assets/documents/uploads).
# Leave empty for same-origin web access; set to the box's address so generated
# download links are reachable externally, e.g. https://aigc.todoucloud.com
PUBLIC_BASE_URL=https://aigc.todoucloud.com
# Public Lot Agent URL used in password-reset emails. Set this to the browser
# address users should open; when empty, the server derives it from the request.
LOT_AGENT_PUBLIC_URL=https://aigc.todoucloud.com

# Personal knowledge-base service. RAG_INTEGRATION_KEY must match RAG's
# LOT_AGENT_INTEGRATION_KEY and is used only by the two backend services.
RAG_API_URL=https://ai-rag.gafz.com.cn
RAG_INTEGRATION_KEY=

# Shared secret proving this Agent (compute box) to new-api on URL token
# auto-login. Sent as `Authorization: Bearer <key>` when exchanging the browser's
# ?token=<jump_token> via /auth/token-login; missing/wrong → 403 invalid agent key.
# Keep as a secret — never hardcode or log it.
NEW_API_AGENT_KEY=

# Generation vendor (image / video) — TokenHub OpenAI-compatible API.
# Shared key used by both image and video unless overridden below.
TOKENHUB_API_KEY=
# Optional per-media keys — set these only when image and video use different
# vendors; each falls back to TOKENHUB_API_KEY when empty.
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=

# 智谱 BigModel web search API key
BIGMODEL_API_KEY=

# Optional: log raw LLM request/response payloads for debugging
DEBUG_LLM=

# Local-dev debug mode. DEBUG=1 disables login (requests run as a seeded "debug"
# user) and uses the env-configured LLM (OPENAI_API_KEY / OPENAI_MODEL /
# OPENAI_BASE_URL) instead of a per-user tokenhub key. NEVER enable in production.
DEBUG=
# Production always uses the admin-managed New API subscription key. This flag
# only opts DEBUG=1 local development into the managed flow.
NEW_API_MANAGED_KEYS=1
NEW_API_INTERNAL_BASE_URL=https://tokenhub.todoucloud.com/api/internal
NEW_API_INTERNAL_CLIENT_ID=lot-agent
NEW_API_INTERNAL_CLIENT_SECRET=
# Agent recharge accepts lot-agent points directly (100 points = CNY 1).
# The payment gateway itself remains behind New API's signed internal control plane.
