# ─────────────────────────────────────────────────────────────
# Lot Agent — environment variables
# Copy to `.env` and fill in. Secrets live here; non-secret
# structure lives in config/default.json (override locally via
# config/local.json). Server throws on startup if PG_PASSWORD is missing.
# Docker Compose deployments use deploy/.env.example instead.
# ─────────────────────────────────────────────────────────────

# LLM (text) — OpenAI-compatible gateway; any OpenAI-compatible endpoint works
# (OpenAI, DeepSeek, local vLLM, …).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenhub.wetok.ai/v1
OPENAI_MODEL=deepseek-v4.1-flash
# Optional default for models without modelCatalog.llmProtocols overrides.
# Base URL includes /v1; providers append /responses or /chat/completions.
OPENAI_PROTOCOL=chat-completions

# Kling custom voice service — server/worker only, independent of LLM/video APIs.
# Base URL includes /v1; the client appends /wand/kling/custom-voices.
# Set a dedicated Tencent TokenHub key. No fallback to inference or user keys.
KLING_VOICE_BASE_URL=https://tokenhub.tencentmaas.com/v1
KLING_VOICE_API_KEY=

# Digital twin voice enrollment — Qwen service, server only.
# Base URL includes /api/v1; client appends /services/audio/tts/customization.
# Dedicated key; no fallback to LLM, video, Tencent, or user inference keys.
# Voice IDs are bound to the target model and to this Qwen account. Dubbing calls
# OPENAI_BASE_URL/audio/speech with the user's key, so the New API Ali channel must
# serve the target model with the SAME Qwen account (maas.qianwenaiapi.com).
QWEN_VOICE_BASE_URL=https://maas.qianwenaiapi.com/api/v1
QWEN_VOICE_API_KEY=
QWEN_VOICE_TARGET_MODEL=qwen-audio-3.0-tts-plus
# PUBLIC_BASE_URL must be reachable by Qwen to read five-minute sample URLs.

# LLM (text) — Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Which text provider the agent uses by default: openai | anthropic
LLM_DEFAULT=openai

# Master key for encrypting secrets at rest (tokenhub api keys, platform
# access tokens) with AES-256-GCM. 64 hex chars (32 bytes) — generate with:
#   openssl rand -hex 32
# A base64-encoded 32-byte key is also accepted. Leave empty and secrets are
# stored in PLAINTEXT (a one-time startup warning is logged); pre-existing
# plaintext rows keep working even after this is set — the read path detects
# the "enc:v1:" prefix and returns legacy values unchanged otherwise. REQUIRED
# in production. Keep as a secret — never commit a real value. Server and
# worker must use the SAME key (they decrypt/encrypt the same rows).
# Also required for marketing material URLs. These URLs expire after 10 minutes.
# Missing keys never fall back to anonymous access for private materials.
SECRET_MASTER_KEY=

# PostgreSQL (business data). Server throws if PG_PASSWORD is empty.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=lot

# Redis — BullMQ queue, generation cache, progress pub/sub. The app reads only
# REDIS_URL; REDIS_PASSWORD is used by Docker Compose to start Redis.
# Example dev value:
REDIS_URL=redis://:rag123456@localhost:6379
REDIS_PASSWORD=rag123456
# HTTP server
PORT=3000
# Allowed CORS origins for the web client (comma-separated)
CORS_ORIGIN=http://localhost:5173,https://aigc.todoucloud.com
# Optional: absolute base for static file URLs (assets/documents/uploads).
# Leave empty for same-origin web access; set to the box's address so generated
# download links are reachable externally, e.g. https://aigc.todoucloud.com
# Also used for ASR temporary audio URLs; the model gateway must be able to reach this API origin.
PUBLIC_BASE_URL=https://aigc.todoucloud.com
# Public Lot Agent URL used in password-reset emails. Set this to the browser
# address users should open; when empty, the server derives it from the request.
LOT_AGENT_PUBLIC_URL=https://aigc.todoucloud.com
# Public browser destination shown in the web app and mini-program (no API path or credentials).
TOKENHUB_PUBLIC_URL=https://tokenhub.todoucloud.com
# Model configuration page linked from the digital employee. Default: https://wetok.ai/
# TOKENHUB_WEB_URL=https://wetok.ai/

# Personal knowledge-base service. RAG_INTEGRATION_KEY must match RAG's
# LOT_AGENT_INTEGRATION_KEY and is used only by the two backend services.
RAG_API_URL=https://ai-rag.gafz.com.cn
RAG_INTEGRATION_KEY=

# Shared secret proving this Agent (compute box) to new-api on URL token
# auto-login. Sent as `Authorization: Bearer <key>` when exchanging the browser's
# ?token=<jump_token> via /auth/token-login; missing/wrong → 403 invalid agent key.
# Keep as a secret — never hardcode or log it.
NEW_API_AGENT_KEY=

# Agent market API of the gateway (user keys, subscriptions, model catalog).
TOKENHUB_BASE_URL=https://tokenhub.wetok.ai/api/agent-market

# Generation vendor (image / video) — TokenHub OpenAI-compatible API.
# Shared key used by both image and video unless overridden below.
TOKENHUB_API_KEY=
# Optional per-media keys — set these only when image and video use different
# vendors; each falls back to TOKENHUB_API_KEY when empty.
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=

# 智谱 BigModel web search API key
BIGMODEL_API_KEY=

# Optional: log raw LLM request/response payloads for debugging
DEBUG_LLM=
# Log level: debug | info | warn | error (default info).
# LOG_LEVEL=info
# Hosts the web_fetch tool may reach on private network addresses (comma-separated).
# Empty keeps every private address blocked; list only trusted internal hosts.
# WEB_FETCH_ALLOW_HOSTS=

# Local-dev debug mode. DEBUG=1 disables login (requests run as a seeded "debug"
# user) and uses the env-configured LLM (OPENAI_API_KEY / OPENAI_MODEL /
# OPENAI_BASE_URL) instead of a per-user tokenhub key. NEVER enable in production.
DEBUG=
# Production always uses the admin-managed New API subscription key. This flag
# only opts DEBUG=1 local development into the managed flow.
NEW_API_MANAGED_KEYS=1
NEW_API_INTERNAL_BASE_URL=https://tokenhub.wetok.ai/api/internal
NEW_API_INTERNAL_CLIENT_ID=lot-agent
NEW_API_INTERNAL_CLIENT_SECRET=
# Agent recharge accepts lot-agent points directly (100 points = CNY 1).
# Web payments retain the existing gateway. Agent owns mini-program virtual payments.
# New API only accepts signed accounting receipts (agent:key.credit scope).

# WeChat mini program (packages/miniprogram). When both are set, the mini
# program silent-logs in with wx.login: unknown openids create a tokenhub
# user (username prefix wx_mini_) keyed by wechat_mp_openid, separate from
# web WeChat QR login (wechat_id). Phone binding uses getPhoneNumber.
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# Mini-program virtual payment: Agent server only. Never configure these in New API.
WECHAT_VIRTUAL_PAY_ENABLED=0
WECHAT_VIRTUAL_PAY_ENV=0
WECHAT_VIRTUAL_PAY_OFFER_ID=
WECHAT_VIRTUAL_PAY_APP_KEY=
WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY=
# Keys are integer points/fen; add "1":"lot_points_1" for a ¥0.01 Android test tier.
# The published WeChat product must also be priced at 1 fen. iOS still requires ¥1.
WECHAT_VIRTUAL_PAY_GOODS={"100":"lot_points_100","500":"lot_points_500","1000":"lot_points_1000","2000":"lot_points_2000","5000":"lot_points_5000","10000":"lot_points_10000"}
# 0 production, 1 sandbox. Sandbox never reports real credit to New API.
# ENABLED stops new sales only; retain credentials for existing-order reconciliation.
# See docs/wechat-virtual-payment.md for setup, migration and acceptance checks.

# S1 private knowledge management API (chat retrieval still uses knowledge.source).
KNOWLEDGE_MANAGEMENT_ENABLED=0

# S2 preparation worker; remains disabled until tokenizer/index profile is verified.
KNOWLEDGE_INGESTION_ENABLED=0
KNOWLEDGE_QUEUE=lot-knowledge
KNOWLEDGE_CONCURRENCY=2

# Independent read-only knowledge API; requires management, ingestion and Redis.
KNOWLEDGE_EXTERNAL_ENABLED=0

KNOWLEDGE_PG_POOL_MAX=4

# 国际界面：>0 默认印尼语，可切换英/中；隐藏手机号登录、注册绑定、账号绑定及桌面版下载入口
# 国际模式同时使用香港 CLOUDDATA AI TECH CO., LIMITED 的服务条款及隐私政策，与界面语言无关
# 省略或 <=0 保持中文及现有手机号入口
globle=0

# PPT thumbnails (optional). Export/editing still work if converters are unavailable.
PPT_PREVIEW=1
# PPT_SOFFICE_PATH=soffice
# PPT_PDFTOPPM_PATH=pdftoppm

# Marketing video clip model: a profile id from core/marketing-video/models.ts
# (grok-imagine-video-1.5 by default, or kling-video-v3-omni). Unknown ids fail at startup.
# MARKETING_VIDEO_MODEL=grok-imagine-video-1.5
# Image model for the optional key-art still shared by every clip of a video
# (billed through the user's own gateway key). Default: gpt-image-2.5-flare.
# MARKETING_KEY_ART_MODEL=gpt-image-2.5-flare
# Marketing renders per worker process, and per user across all workers (1–16).
# Clips submitted at once within one render (1–15; worker only). Not related to
# MARKETING_ANALYSIS_CONCURRENCY, which limits reference video analyses.
# Clip requests at once per worker = CONCURRENCY × SEGMENT_CONCURRENCY; raise only
# after checking vendor rate limits, queue wait P95 and memory. The default 4 clips
# make a 60-second video in one round.
# Each render holds one worker PG connection for its whole run: the worker refuses
# to start unless PG_POOL_MAX (worker pool, default 20, 4–200) >= 2 × CONCURRENCY + 2.
# MARKETING_VIDEO_CONCURRENCY=2
# MARKETING_VIDEO_USER_CONCURRENCY=1
# MARKETING_VIDEO_SEGMENT_CONCURRENCY=4
# PG_POOL_MAX=20
# Operations API, no UI, with "Authorization: Bearer <key>":
# GET /api/admin/metrics/marketing?hours=24 (1–720): success rates, stage timings,
# queue wait P95 and unknown backlog of marketing videos and digital presenters;
# GET /api/admin/reconciliation/marketing?hours=168: requests to check against
# the gateway logs, with gateway request, user and token IDs. At least 32
# characters, e.g. `openssl rand -hex 32`; unset disables the API (404). Never
# give it to clients.
# ADMIN_API_KEY=

# Marketing video composition: install on both API and video worker hosts.
# Requires libx264/AAC; burned captions also require libass and CJK fonts.
# MARKETING_FFMPEG_PATH=ffmpeg
# MARKETING_FFPROBE_PATH=ffprobe
# Font family for burned captions of twin-narrated videos (must be installed on the worker).
# MARKETING_SUBTITLE_FONT=Noto Sans CJK SC

# Desktop release build only: export these in the shell before pnpm dist:desktop.
# pack.mjs does not load this .env file. When unset, auto-update is disabled.
# See docs/desktop-updates.md. Store the private signing key outside the repository.
# LOT_DESKTOP_UPDATE_URL=https://todoucloud.com/updates/stable/
# LOT_DESKTOP_UPDATE_PUBLIC_KEY_FILE=/absolute/path/update-public.pem
# Docker Compose override: deploy/docker-compose.desktop-updates.yml
# DESKTOP_UPDATES_DIR=/srv/lot-agent/updates
# Feishu: each user creates a personal bot via official QR setup.
# App credentials are encrypted in the database per user, never configured here.
# SECRET_MASTER_KEY is REQUIRED for encrypted app secrets and OAuth tokens.
FEISHU_ENABLED=1
FEISHU_LONG_CONNECTION=1
# Reference video analysis (Linux sandbox + dedicated media-analysis worker).
# Billing and balance checks are handled by the upstream gateway. Configure a verified downloader.
MARKETING_ANALYSIS_ENABLED=0
MARKETING_ANALYSIS_CONCURRENCY=2
# Per-video parallel work; task concurrency above is across different users.
# OCR 1–16, visual batches 1–4, isolated decoder threads 1–8.
MARKETING_ANALYSIS_OCR_CONCURRENCY=8
MARKETING_ANALYSIS_VISUAL_CONCURRENCY=3
MARKETING_ANALYSIS_DECODE_THREADS=4
# Apple Silicon macOS development only: opt in to sandbox-exec isolation.
# Rejected with NODE_ENV=production or on other platforms; Linux stays default.
MARKETING_ANALYSIS_MACOS_SANDBOX=0
# Pinned yt-dlp release (YYYY.MM.DD), checked at runtime. YTDLP_SHA256 is only the
# --build-arg of Dockerfile.media-analysis for the matching platform executable.
YTDLP_VERSION=
YTDLP_SHA256=

# 参考视频累计存储准入（按用户计算已存字节，并为排队/运行任务预留空间）
# MARKETING_ANALYSIS_OWNER_BYTES=2147483648
# MARKETING_ANALYSIS_MIN_FREE_BYTES=1073741824
