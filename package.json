{
  "name": "lot-agent",
  "private": true,
  "scripts": {
    "dev": "concurrently -n core,server,worker,knowledge,media,web -c blue,green,cyan,yellow,white,magenta \"pnpm --filter @lot-agent/core run dev\" \"pnpm --filter @lot-agent/server run dev\" \"pnpm --filter @lot-agent/server run dev:worker\" \"pnpm --filter @lot-agent/server run dev:knowledge\" \"pnpm --filter @lot-agent/server run dev:media-analysis\" \"pnpm --filter @lot-agent/web run dev\"",
    "dev:server": "pnpm --filter @lot-agent/server run dev",
    "dev:web": "pnpm --filter @lot-agent/web run dev",
    "dev:desktop": "pnpm --filter @lot-agent/desktop run build && concurrently -n web,electron -c magenta,yellow \"pnpm --filter @lot-agent/web run dev --mode desktop\" \"wait-on http://localhost:5173 && pnpm --filter @lot-agent/desktop run dev\"",
    "dist:desktop": "pnpm --filter @lot-agent/desktop run dist",
    "dist:desktop:win": "pnpm --filter @lot-agent/desktop run dist:win",
    "dist:desktop:mac": "pnpm --filter @lot-agent/desktop run dist:mac",
    "release:desktop": "node packages/desktop/scripts/release.mjs",
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "test": "vitest run",
    "test:knowledge": "pnpm --filter @lot-agent/core run build && vitest run packages/core/src/knowledge packages/server/src/knowledge packages/server/src/services/agent-service.knowledge-source.test.ts packages/server/src/services/rag-client.test.ts",
    "check:knowledge:db": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-db.ts",
    "check:knowledge:parsers": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-parsers.ts",
    "check:knowledge:integration": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-integration.ts",
    "check:knowledge:retrieval": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-retrieval.ts",
    "dev:knowledge": "pnpm --filter @lot-agent/server run dev:knowledge",
    "check:knowledge:live": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-live.ts",
    "knowledge:reindex": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/reindex-knowledge.ts",
    "knowledge:billing": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/knowledge-billing.ts",
    "knowledge:gc": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/collect-knowledge-garbage.ts",
    "knowledge:index": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/knowledge-index.ts",
    "check:knowledge:ui": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-ui.ts",
    "check:agent-navigation:ui": "node packages/server/scripts/check-agent-navigation-ui.mjs",
    "check:marketing-video:ui": "node packages/server/scripts/check-marketing-video-ui.mjs",
    "check:marketing-video:db": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-marketing-video-db.ts",
    "check:digital-twin:ui": "node packages/server/scripts/check-digital-twin-ui.mjs",
    "knowledge:backup": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/knowledge-backup.ts",
    "check:knowledge:restore": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-restore.ts",
    "check:knowledge:upgrade": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-upgrade.ts",
    "check:knowledge:chat": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-chat.ts",
    "check:knowledge:eval": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/evaluate-knowledge.ts",
    "check:knowledge:release": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-release.ts",
    "check:knowledge:persistence": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-knowledge-persistence.ts",
    "check:desktop-tools:ui": "node packages/server/scripts/check-desktop-tools-ui.mjs",
    "check:feishu:ui": "node packages/server/scripts/check-feishu-ui.mjs",
    "check:desktop-updates:ui": "node packages/server/scripts/check-desktop-updates-ui.mjs",
    "test:marketing-analysis": "pnpm --filter @lot-agent/core build && vitest run packages/core/src/llm packages/core/src/marketing-analysis packages/server/src/marketing-analysis packages/server/src/models/provider-factory.test.ts packages/server/src/config.test.ts",
    "check:marketing-analysis:media": "pnpm --filter @lot-agent/core build && MARKETING_ANALYSIS_MEDIA_TEST=1 vitest run packages/server/src/marketing-analysis/frames.test.ts",
    "check:marketing-analysis:live": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-marketing-analysis.ts",
    "check:marketing-analysis:local": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-marketing-analysis-local.ts",
    "check:marketing-analysis:local-sandbox": "pnpm --filter @lot-agent/core build && MARKETING_ANALYSIS_LOCAL_SANDBOX_TEST=1 vitest run packages/server/src/marketing-analysis/local-probe.test.ts",
    "dev:media-analysis": "pnpm --filter @lot-agent/server run dev:media-analysis",
    "check:marketing-analysis:db": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/check-marketing-analysis-db.ts",
    "check:marketing-analysis:ui": "node packages/server/scripts/check-marketing-analysis-ui.mjs",
    "marketing-analysis:reconcile": "pnpm --filter @lot-agent/server exec node --import tsx/esm scripts/reconcile-marketing-analysis.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "wait-on": "^9.1.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
