    "/profile": {
      "get": {
        "description": "Requires profile:read; only current explicitly shared facts. Does not return history or suggestions.",
        "parameters": [
          {
            "in": "query",
            "name": "keys",
            "required": true,
            "schema": {
              "type": "string",
              "description": "1–50 comma-separated canonical field names"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "value": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "array"
                            ],
                            "items": {
                              "type": "string"
                            }
                          },
                          "value_type": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "version": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "key",
                          "value",
                          "value_type",
                          "category",
                          "version"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "request_id",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
