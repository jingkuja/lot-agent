  "components": {
    "securitySchemes": {
      "KnowledgeKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent lotk_ knowledge key; never a login token or TokenHub key"
      }
    },
    "schemas": {
      "RetrievalRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "collection_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          },
          "mode": {
            "type": "string",
            "enum": [
              "keyword",
              "semantic",
              "hybrid"
            ],
            "default": "hybrid"
          },
          "allow_degraded": {
            "type": "boolean",
            "default": false
          },
          "filters": {
            "type": "object",
            "properties": {
              "source_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "document",
                    "note",
                    "bookmark",
                    "image",
                    "audio",
                    "video",
                    "profile_fact"
                  ]
                },
                "minItems": 1,
                "maxItems": 7,
                "default": [
                  "document",
                  "note"
                ]
              },
              "tags": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "query",
          "collection_ids"
        ],
        "additionalProperties": false
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "collection_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "document",
              "note",
              "bookmark",
              "image",
              "audio",
              "video",
              "profile_fact"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "extracted_text",
              "manual_description",
              "confirmed_fact",
              "ocr",
              "transcript",
              "generated_description"
            ]
          },
          "score": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "rrf",
                  "cosine",
                  "ts_rank_cd"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          "citation": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "pdf"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "page"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "text"
                  },
                  "startLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "endLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "startLine",
                  "endLine"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "docx"
                  },
                  "paragraph": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "heading": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "paragraph"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "media"
                  },
                  "startSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "startSeconds"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "item_id",
          "revision_id",
