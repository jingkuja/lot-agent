# ───────── Lot Agent 盒子侧 OTA 配置 ─────────
# 复制为 /opt/lot-agent/box.env，由 lot-updater.service 的 EnvironmentFile 加载。
# 注意：镜像 tag(APP_TAG/WEB_TAG)不放这里，放 compose 的 .env（updater 会改写它）。

# 你方更新服务端（HTTPS）
UPDATE_SERVER=https://update.example.com
# 本盒子唯一标识 + 鉴权 token（一盒一码，由你方签发）
BOX_ID=box-0001
BOX_TOKEN=replace-with-issued-token
# 发版渠道（stable / beta），服务端按渠道决定该盒子该收哪个版本
UPDATE_CHANNEL=stable

# 每晚定时更新窗口（盒子本地时区，24h HH:MM）。窗口内才允许自动版本更新；
# 手动标记(update_now)绕过此窗口。支持跨午夜，如 23:30 → 00:30。
UPDATE_WINDOW_START=00:00
UPDATE_WINDOW_END=00:30

# 健康检查超时（秒）：超时即判失败并自动回滚
HEALTH_TIMEOUT=90
# 本地保留的历史镜像版本数（用于回滚），≥2
KEEP_VERSIONS=2

# web 容器对外端口（与 compose 的 WEB_PORT 一致，健康检查用）
WEB_PORT=80
# 下载前要求的额外磁盘余量（MB）
MIN_FREE_MB=2048

# 路径（一般无需改）
APP_DIR=/opt/lot-agent
ENV_FILE=/opt/lot-agent/.env
STATE_DIR=/var/lib/lot-ota
