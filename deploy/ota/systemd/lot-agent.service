# 开机兜底拉起整个 compose 栈。容器自身 restart: unless-stopped 已能随 Docker
# 自恢复；本单元处理「容器被删 / compose 变更 / 首启次序」等边角情况。
[Unit]
Description=Lot Agent docker compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lot-agent
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
