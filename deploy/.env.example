# ─────────────────────────────────────────────────────────────
# Lot Agent — Docker Compose environment (docker-compose.yml)
# Copy to `.env` next to docker-compose.yml and fill in. Compose sets the
# container addresses itself (PG_HOST, PG_PORT, REDIS_URL, PORT, ROLE), so
# they are not configured here. Local development without Docker uses the
# root .env.example. Empty values fall back to the defaults in docker-compose.yml.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (business data). Compose refuses to start without PG_PASSWORD.
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=lot
# Worker PG pool (4–200); must be at least 2 × MARKETING_VIDEO_CONCURRENCY + 2.
PG_POOL_MAX=20

# Redis password; compose starts Redis with it and builds REDIS_URL.
REDIS_PASSWORD=

# Host port of the web (nginx) container.
WEB_PORT=80

# Master key for encrypting secrets at rest (user API keys, platform tokens,
# Feishu app secrets) and signing private material links: `openssl rand -hex 32`.
# REQUIRED in production; server and workers share it. Never commit a real value.
SECRET_MASTER_KEY=

# 国际界面：>0 默认印尼语，可切换英/中；隐藏手机号登录、注册绑定、账号绑定及桌面版下载入口
# 省略或 <=0 保持中文及现有手机号入口
globle=0

# Log level: debug | info | warn | error.
LOG_LEVEL=info

# Text models — OpenAI-compatible gateway, or Anthropic.
LLM_DEFAULT=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenhub.wetok.ai/v1
OPENAI_MODEL=deepseek-v4.1-flash
# chat-completions | responses; the base URL includes /v1.
OPENAI_PROTOCOL=chat-completions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# 智谱 BigModel web search API key
BIGMODEL_API_KEY=
# Optional: log raw LLM request/response payloads for debugging
DEBUG_LLM=
# Hosts the web_fetch tool may reach on private network addresses (comma-separated).
# Empty keeps every private address blocked; list only trusted internal hosts.
WEB_FETCH_ALLOW_HOSTS=

# Gateway (New API / TokenHub)
TOKENHUB_BASE_URL=https://tokenhub.wetok.ai/api/agent-market
# Image / video generation key; per-media keys override it when set.
TOKENHUB_API_KEY=
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=
# Shared secret proving this Agent to New API on URL token auto-login.
NEW_API_AGENT_KEY=
# Production always uses the admin-managed New API subscription key.
NEW_API_MANAGED_KEYS=1
NEW_API_INTERNAL_BASE_URL=https://tokenhub.wetok.ai/api/internal
NEW_API_INTERNAL_CLIENT_ID=lot-agent
NEW_API_INTERNAL_CLIENT_SECRET=

# Public addresses
# Allowed CORS origins for the web client (comma-separated).
CORS_ORIGIN=http://localhost
# Absolute base for static file URLs; empty for same-origin access. Also used for
# ASR and voice-sample URLs, so the model gateway must be able to reach it.
PUBLIC_BASE_URL=
# Address users open from password-reset emails; empty derives it from the request.
LOT_AGENT_PUBLIC_URL=
# Public gateway page shown in the web app and mini-program.
TOKENHUB_PUBLIC_URL=https://tokenhub.todoucloud.com
# Model configuration page linked from the digital employee; empty uses https://wetok.ai/.
TOKENHUB_WEB_URL=

# Personal knowledge base. RAG_INTEGRATION_KEY must match RAG's LOT_AGENT_INTEGRATION_KEY.
RAG_API_URL=https://ai-rag.gafz.com.cn
RAG_INTEGRATION_KEY=
KNOWLEDGE_MANAGEMENT_ENABLED=0
KNOWLEDGE_INGESTION_ENABLED=0
KNOWLEDGE_EXTERNAL_ENABLED=0
KNOWLEDGE_QUEUE=lot-knowledge
KNOWLEDGE_CONCURRENCY=2
KNOWLEDGE_PG_POOL_MAX=4

# WeChat login and payment credentials belong only to the Agent server.
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# Mini-program virtual payment: Agent server only. Never configure these in New API.
WECHAT_VIRTUAL_PAY_ENABLED=0
WECHAT_VIRTUAL_PAY_ENV=0
WECHAT_VIRTUAL_PAY_OFFER_ID=
WECHAT_VIRTUAL_PAY_APP_KEY=
WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY=
# Keys are integer points/fen; add "1":"lot_points_1" for a ¥0.01 Android test tier.
# The published WeChat product must also be priced at 1 fen. iOS still requires ¥1.
WECHAT_VIRTUAL_PAY_GOODS={"100":"lot_points_100","500":"lot_points_500","1000":"lot_points_1000","2000":"lot_points_2000","5000":"lot_points_5000","10000":"lot_points_10000"}
# 0 production, 1 sandbox. Sandbox never reports real credit to New API.
# ENABLED stops new sales only; retain credentials for existing-order reconciliation.
# See docs/wechat-virtual-payment.md for setup, migration and acceptance checks.

# Kling custom voice service (independent of inference/video credentials).
# Client appends /wand/kling/custom-voices to the /v1 base URL.
KLING_VOICE_BASE_URL=https://tokenhub.tencentmaas.com/v1
KLING_VOICE_API_KEY=
# Digital twin voice enrollment (Qwen), dedicated key. Voice IDs are bound to this
# account; the gateway's Ali channel must serve the target model with the same account.
QWEN_VOICE_BASE_URL=https://maas.qianwenaiapi.com/api/v1
QWEN_VOICE_API_KEY=
QWEN_VOICE_TARGET_MODEL=qwen-audio-3.0-tts-plus

# Feishu official QR setup; see docs/feishu.md. Requires SECRET_MASTER_KEY.
# App credentials are encrypted in the database per user, never configured here.
FEISHU_ENABLED=1
FEISHU_LONG_CONNECTION=1

# PPT thumbnails (0 disables; export and editing still work).
PPT_PREVIEW=1
PPT_SOFFICE_PATH=soffice
PPT_PDFTOPPM_PATH=pdftoppm

# Marketing video. Clip model: grok-imagine-video-1.5 or kling-video-v3-omni.
MARKETING_VIDEO_MODEL=grok-imagine-video-1.5
# Image model for the key-art still shared by every clip (billed through the user's key).
MARKETING_KEY_ART_MODEL=gpt-image-2.5-flare
# Renders per worker and per user (1–16); clips at once within one render (1–15).
MARKETING_VIDEO_CONCURRENCY=2
MARKETING_VIDEO_USER_CONCURRENCY=1
MARKETING_VIDEO_SEGMENT_CONCURRENCY=4
MARKETING_FFMPEG_PATH=ffmpeg
MARKETING_FFPROBE_PATH=ffprobe
# Font of burned captions; the app image installs Noto CJK.
MARKETING_SUBTITLE_FONT=Noto Sans CJK SC
# Operations API key (at least 32 characters, `openssl rand -hex 32`); empty disables /api/admin.
ADMIN_API_KEY=

# Reference video analysis (start with `--profile media-analysis`).
MARKETING_ANALYSIS_ENABLED=0
MARKETING_ANALYSIS_CONCURRENCY=2
# Per-video parallel work: OCR 1–16, visual batches 1–4, decoder threads 1–8.
MARKETING_ANALYSIS_OCR_CONCURRENCY=8
MARKETING_ANALYSIS_VISUAL_CONCURRENCY=3
MARKETING_ANALYSIS_DECODE_THREADS=4
# Storage admission; each value is an integer of at least 536870912 bytes.
MARKETING_ANALYSIS_OWNER_BYTES=2147483648
MARKETING_ANALYSIS_MIN_FREE_BYTES=1073741824
# Pinned yt-dlp release (YYYY.MM.DD), checked at runtime. YTDLP_SHA256 is only the
# --build-arg of Dockerfile.media-analysis for the matching platform executable.
YTDLP_VERSION=
YTDLP_SHA256=

# Desktop update files, used only by deploy/docker-compose.desktop-updates.yml.
# DESKTOP_UPDATES_DIR=/srv/lot-agent/updates
