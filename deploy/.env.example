# ─────────────────────────────────────────────────────────────
# Lot Agent — environment variables
# Copy to `.env` and fill in. Secrets live here; non-secret
# structure lives in config/default.json (override locally via
# config/local.json). Server throws on startup if PG_PASSWORD is missing.
# ─────────────────────────────────────────────────────────────

# LLM (text) — OpenAI-compatible. Default points at DeepSeek; any
# OpenAI-compatible endpoint works (OpenAI, DeepSeek, local vLLM, …).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenhub.todoucloud.com/v1
OPENAI_MODEL=deepseek-v4-flash

# LLM (text) — Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Which text provider the agent uses by default: openai | anthropic
LLM_DEFAULT=openai

# PostgreSQL (business data). Server throws if PG_PASSWORD is empty.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=lot

# Redis — BullMQ queue, generation cache, progress pub/sub
# Example dev value:
REDIS_URL=redis://:rag123456@localhost:6379
REDIS_PASSWORD=rag123456
# HTTP server
PORT=3000
# Allowed CORS origin for the web client (Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Optional: absolute base for static file URLs (assets/documents/uploads).
# Leave empty for same-origin web access; set to the box's address so generated
# download links are reachable externally, e.g. http://192.168.1.50:3000
PUBLIC_BASE_URL=

# Generation vendor (image / video) — TokenHub OpenAI-compatible API.
# Shared key used by both image and video unless overridden below.
TOKENHUB_API_KEY=
# Optional per-media keys — set these only when image and video use different
# vendors; each falls back to TOKENHUB_API_KEY when empty.
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=

# 智谱 BigModel web search API key
BIGMODEL_API_KEY=

# Optional: log raw LLM request/response payloads for debugging
DEBUG_LLM=

KNOWLEDGE_MANAGEMENT_ENABLED=0

KNOWLEDGE_INGESTION_ENABLED=0

KNOWLEDGE_EXTERNAL_ENABLED=0

KNOWLEDGE_QUEUE=lot-knowledge

KNOWLEDGE_CONCURRENCY=2

KNOWLEDGE_PG_POOL_MAX=4

# 国际界面：>0 默认印尼语，可切换英/中；隐藏手机号登录、注册绑定及账号绑定
# 省略或 <=0 保持中文及现有手机号入口
globle=0

# WeChat login and payment credentials belong only to the Agent server.
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# Mini-program virtual payment: Agent server only. Never configure these in New API.
WECHAT_VIRTUAL_PAY_ENABLED=0
WECHAT_VIRTUAL_PAY_ENV=0
WECHAT_VIRTUAL_PAY_OFFER_ID=
WECHAT_VIRTUAL_PAY_APP_KEY=
WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY=
# Keys are integer points/fen; add "1":"lot_points_1" for a ¥0.01 Android test tier.
# The published WeChat product must also be priced at 1 fen. iOS still requires ¥1.
WECHAT_VIRTUAL_PAY_GOODS={"100":"lot_points_100","500":"lot_points_500","1000":"lot_points_1000","2000":"lot_points_2000","5000":"lot_points_5000","10000":"lot_points_10000"}
# 0 production, 1 sandbox. Sandbox never reports real credit to New API.
# ENABLED stops new sales only; retain credentials for existing-order reconciliation.
# See docs/wechat-virtual-payment.md for setup, migration and acceptance checks.
