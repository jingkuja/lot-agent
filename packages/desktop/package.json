{
  "name": "@lot-agent/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Lot Agent desktop client (Electron shell over @lot-agent/web)",
  "author": "Lot Agent",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsup",
    "icons": "node scripts/make-icons.mjs",
    "dev": "tsup && node scripts/dev.mjs",
    "start": "electron .",
    "dist": "node scripts/pack.mjs",
    "dist:mac": "node scripts/pack.mjs --mac",
    "dist:win": "node scripts/pack.mjs --win nsis --x64",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
