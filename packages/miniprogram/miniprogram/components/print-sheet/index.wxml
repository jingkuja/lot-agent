<view class="sheet {{busy ? 'busy' : ''}}" bindtap="onPreview">
  <image wx:if="{{src}}" class="print" src="{{src}}" mode="aspectFit" />
  <view wx:else class="empty">
    <slot></slot>
  </view>
  <view wx:if="{{busy}}" class="mask">
    <view class="spinner"></view>
    <text class="mask-text">{{caption || '正在生成'}}</text>
  </view>
</view>
