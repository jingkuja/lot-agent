.sheet {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(90, 60, 70, 0.08);
}

.print {
  width: 100%;
  height: 620rpx;
  background: #f6efe9;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 420rpx;
  color: #9a8f8a;
  text-align: center;
}

.mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  background: rgba(255, 255, 255, 0.82);
}

.spinner {
  width: 72rpx;
  height: 72rpx;
  border: 8rpx solid #ffe9ee;
  border-top-color: #ff5c7a;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.mask-text {
  color: #f0436a;
  font-size: 26rpx;
}
