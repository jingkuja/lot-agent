/* 两层错位颗粒铺满画面；额外出血避免动画位移时露出空白边缘。 */
.generation-grain {
  position: absolute;
  top: -24rpx;
  right: -24rpx;
  bottom: -24rpx;
  left: -24rpx;
  pointer-events: none;
  background-image:
    radial-gradient(circle at 17% 29%, var(--muted) 1rpx, transparent 2rpx),
    radial-gradient(circle at 73% 61%, var(--brand) 1.5rpx, transparent 2.5rpx),
    radial-gradient(circle at 41% 83%, var(--ink) 1rpx, transparent 2rpx),
    radial-gradient(circle at 89% 13%, var(--muted) 1.5rpx, transparent 2.5rpx);
  background-size: 19rpx 23rpx, 31rpx 37rpx, 41rpx 29rpx, 47rpx 43rpx;
  opacity: 0.3;
  animation: generation-grain-shift 0.8s steps(1, end) infinite;
}

.generation-grain-secondary {
  background-size: 23rpx 31rpx, 37rpx 19rpx, 29rpx 43rpx, 41rpx 47rpx;
  opacity: 0.2;
  animation-duration: 1.1s;
  animation-delay: -0.4s;
  animation-direction: reverse;
}

@keyframes generation-grain-shift {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(-10rpx, 8rpx); }
  40% { transform: translate(12rpx, -6rpx); }
  60% { transform: translate(-6rpx, -12rpx); }
  80% { transform: translate(8rpx, 10rpx); }
}

/* 数字独立定位，状态文字换行也不会挤偏画面中心。 */
.generation-progress {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: var(--brand-deep);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
  text-shadow: 0 0 12rpx var(--card), 0 0 24rpx var(--card);
}

.generation-status {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: 24rpx;
  right: 24rpx;
  color: var(--muted);
  line-height: 1.5;
  text-align: center;
  text-shadow: 0 0 8rpx var(--card), 0 0 16rpx var(--card);
}

@media (prefers-reduced-motion: reduce) {
  .generation-grain {
    animation: none;
  }
}
