page {
  /* 暖白奶油底 + 桃粉主色,面向大众的轻快风格 */
  --bg: #faf7f4;
  --card: #ffffff;
  --ink: #33302e;
  --muted: #9a8f8a;
  --line: #f1e9e4;
  --brand: #ff5c7a;
  --brand-deep: #f0436a;
  --brand-soft: #ffe9ee;
  --peach: #ffb26b;
  --lavender: #a78bfa;
  --mint: #4ed3a5;
  --sky: #5bb6f0;
  --gold: #f5b942;
  --radius: 28rpx;
  --shadow: 0 8rpx 30rpx rgba(90, 60, 70, 0.08);
  background: var(--bg);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", sans-serif;
  font-size: 28rpx;
  min-height: 100%;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(900rpx 500rpx at 90% -5%, rgba(255, 92, 122, 0.07), transparent 60%),
    radial-gradient(700rpx 420rpx at -10% 12%, rgba(255, 178, 107, 0.08), transparent 55%),
    var(--bg);
}

/* ---------- 文本 ---------- */
.eyebrow {
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.32em;
  text-transform: uppercase;
}

.h1 {
  margin: 6rpx 0 0;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.h2 {
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.12s ease;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(240, 67, 106, 0.32);
}

.btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.btn-ghost {
  border: 2rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  box-shadow: var(--shadow);
}

.btn-soft {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

/* ---------- 卡片 ---------- */
.card {
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow);
}

/* ---------- 表单 ---------- */
.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field > text {
  color: var(--muted);
  font-size: 24rpx;
}

.input,
.area {
  padding: 26rpx 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.input:focus,
.area:focus {
  border-color: rgba(255, 92, 122, 0.5);
}

.area {
  min-height: 150rpx;
  line-height: 1.6;
}

/* ---------- 小标签 chip ---------- */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 14rpx 26rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--card);
  color: var(--muted);
  font-size: 24rpx;
}

.chip.on {
  border-color: transparent;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #fff;
  font-weight: 600;
}

/* ---------- 生成中的纸面(print-sheet 组件用全局变量即可) ---------- */
.sheet {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow);
}

/* ---------- 底部安全区 ---------- */
.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* ---------- 原生 button 复位 ---------- */
button {
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1.4;
  font-size: 30rpx;
}

button::after {
  border: none;
}
