page {
  --bg: #faf6f0;
  --card: #fffdf9;
  --ink: #403931;
  --muted: #82766c;
  --line: #e7dfd5;
  --brand: #c86b4b;
  --brand-deep: #a84e33;
  --brand-soft: #f5e6da;
  --surface: #f1ebe2;
  --inverse: #fffdf9;
  --poster-rose: #edd6cc;
  --poster-gold: #e6ce8d;
  --poster-peach: #e6d6ba;
  --poster-lavender: #dcd9e7;
  --poster-mint: #cfdacf;
  --poster-sky: #ccd9dc;
  --radius: 18rpx;
  --shadow: 0 4rpx 16rpx rgba(37, 40, 32, 0.04);
  background: var(--bg);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.page-heading {
  padding: 20rpx 0 32rpx;
}

.eyebrow {
  display: block;
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.h1 {
  display: block;
  margin: 12rpx 0;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.h2 {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.section-label {
  display: block;
  margin: 36rpx 0 16rpx;
  color: var(--muted);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--radius);
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 500;
}

.btn:active {
  opacity: 0.75;
}

.btn-primary {
  background: var(--brand);
  color: var(--inverse);
}

.btn-ghost {
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
}

.btn-soft {
  background: var(--surface);
  color: var(--ink);
}

button[disabled], .btn[disabled] {
  opacity: 0.45;
}

.card {
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  box-sizing: border-box;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field > text {
  color: var(--muted);
  font-size: 24rpx;
}

.input, .area {
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
  width: 100%;
}

.input:focus, .area:focus {
  border-color: var(--brand);
}

.area {
  min-height: 150rpx;
}

.ph {
  color: var(--muted);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.chip.on {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--inverse);
}

.sheet {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--card);
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

button {
  margin: 0;
  padding: 0;
  border: none;
  border-radius: var(--radius);
  background: transparent;
  line-height: 1.5;
  font-size: 28rpx;
}

button::after {
  border: none;
}

/* 统一的线条图形，可直接用于 view，避免系统 emoji 的样式差异。 */

.photo-mark {
  position: relative;
  width: 44rpx;
  height: 36rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.photo-mark::before {
  content: "";
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  top: 6rpx;
  right: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.photo-mark::after {
  content: "";
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  left: 0;
  top: 21rpx;
  border: 2rpx solid currentColor;
  transform: rotate(45deg);
}
