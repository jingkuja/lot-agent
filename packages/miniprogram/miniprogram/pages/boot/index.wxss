.login {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 148rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  color: var(--brand);
  transform: rotate(-7deg);
}

.logo .photo-mark {
  width: 68rpx;
  height: 54rpx;
}

.logo .photo-mark::after {
  width: 48rpx;
  height: 48rpx;
  top: 30rpx;
}

.tagline {
  color: var(--ink);
  font-size: 26rpx;
  margin-bottom: 36rpx;
}

.err {
  display: block;
  margin: 40rpx 0 0;
  color: var(--brand-deep);
  font-size: 24rpx;
  text-align: center;
}

.enter {
  width: 100%;
  margin-top: 32rpx;
}
