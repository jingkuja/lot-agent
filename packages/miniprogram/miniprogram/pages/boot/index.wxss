.login {
  padding: 100rpx 44rpx 44rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 64rpx;
  text-align: center;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 12rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--peach) 100%);
  font-size: 64rpx;
  box-shadow: 0 16rpx 36rpx rgba(240, 67, 106, 0.28);
}

.ph {
  color: #c6bab4;
}

.err {
  display: block;
  margin: 20rpx 0 0;
  color: var(--brand-deep);
  font-size: 24rpx;
}

.enter {
  width: 100%;
  margin-top: 36rpx;
}

.server {
  margin-top: 48rpx;
  font-size: 20rpx;
  text-align: center;
}

.server-edit {
  margin-top: 20rpx;
  gap: 16rpx;
}
