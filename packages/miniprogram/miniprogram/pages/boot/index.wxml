<view class="page login">
  <view class="brand">
    <view class="logo"><view class="photo-mark"></view></view>
    <text class="h1">美图海报</text>
    <text class="tagline">把日常，做成喜欢的模样。</text>
    <text class="muted">正在连接账号…</text>
  </view>

  <text wx:if="{{error}}" class="err">{{error}}</text>
  <button wx:if="{{error}}" class="btn btn-primary enter" loading="{{loading}}" bindtap="retry">重新连接</button>
</view>
