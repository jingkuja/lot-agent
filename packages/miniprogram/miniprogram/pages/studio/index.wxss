.studio {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ---------- 结果区 ---------- */
.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx 8rpx;
}

.frame {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 560rpx;
  overflow: hidden;
}

.frame-img {
  width: 100%;
  height: 640rpx;
  background: #f6efe9;
}

.frame-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.frame-emoji {
  font-size: 96rpx;
}

.frame-title {
  font-size: 36rpx;
  font-weight: 700;
}

.frame-busy {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  background: rgba(255, 255, 255, 0.82);
}

.spinner {
  width: 72rpx;
  height: 72rpx;
  border: 8rpx solid var(--brand-soft);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.frame-status {
  color: var(--brand-deep);
  font-size: 26rpx;
}

.stage-actions {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
}

.stage-save {
  width: 60%;
}

.stage-tip {
  margin-top: 16rpx;
  text-align: center;
}

/* ---------- 底部操作区 ---------- */
.dock {
  padding: 14rpx 24rpx 6rpx;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 30rpx rgba(90, 60, 70, 0.06);
}

/* 参考图 */
.refs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.ref {
  position: relative;
  display: inline-block;
  width: 96rpx;
  height: 96rpx;
  margin-right: 14rpx;
  vertical-align: top;
}

.ref image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
}

.ref-x {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.ref-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx dashed #e5d8d2;
  border-radius: 20rpx;
  color: var(--muted);
  font-size: 44rpx;
  box-sizing: border-box;
}

/* 快捷入口 */
.quick {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 4rpx;
  border-radius: 22rpx;
  background: #fbf6f2;
  color: var(--ink);
  font-size: 22rpx;
}

.quick-item.on {
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 600;
}

.quick-ico {
  font-size: 36rpx;
}

/* 灵感 */
.ideas {
  max-height: 300rpx;
  margin-bottom: 16rpx;
  padding: 10rpx 20rpx;
  overflow: auto;
}

.idea {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
  color: #6f655f;
  font-size: 24rpx;
  line-height: 1.5;
}

.idea:last-child {
  border-bottom: none;
}

/* 更多选项 */
.more {
  margin-bottom: 16rpx;
  padding: 6rpx 24rpx;
}

.more-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.more-row:last-child {
  border-bottom: none;
}

.more-k {
  font-size: 28rpx;
}

.more-v {
  color: var(--brand-deep);
  font-size: 26rpx;
}

/* 输入 + 生成 */
.composer {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.composer-input {
  flex: 1;
  min-height: 96rpx;
  max-height: 220rpx;
  border-radius: 26rpx;
}

.ph {
  color: #c6bab4;
}

.go {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(240, 67, 106, 0.32);
}

.go:active {
  transform: scale(0.96);
}

.go.going {
  opacity: 0.7;
}
