@import "../../styles/generation-loading.wxss";

.studio {
  display: flex;
  flex-direction: column;
}

.studio-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 36rpx 24rpx;
}

.studio-heading .h1 {
  margin-bottom: 0;
  font-size: 44rpx;
}

.studio-caption {
  flex-shrink: 0;
  white-space: pre-line;
  text-align: right;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.7;
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 36rpx 12rpx;
}

.frame {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 430rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.frame-img {
  display: block;
  width: 100%;
  height: 560rpx;
  background: var(--surface);
}

.frame-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.canvas-art {
  position: relative;
  width: 136rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--line);
  transform: rotate(-7deg);
}

.art-sun {
  position: absolute;
  top: 28rpx;
  right: 24rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--brand);
}

.art-hill {
  position: absolute;
  width: 160rpx;
  height: 130rpx;
  top: 88rpx;
  left: -28rpx;
  border-radius: 50% 50% 0 0;
  background: var(--poster-mint);
  transform: rotate(24deg);
}

.art-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 22rpx;
  background: var(--card);
}

.frame-title {
  font-size: 28rpx;
  font-weight: 500;
}

.frame-empty .muted {
  font-size: 22rpx;
}

.frame-busy {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: var(--bg);
}

.frame-progress {
  font-size: 64rpx;
  letter-spacing: 2rpx;
}

.frame-status {
  margin-top: 54rpx;
  font-size: 24rpx;
}

.stage-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  gap: 20rpx;
}

.stage-meta .muted, .canvas-ratio {
  font-size: 20rpx;
  color: var(--muted);
}

.stage-save {
  padding: 12rpx 0 12rpx 20rpx;
  color: var(--brand);
  font-size: 24rpx;
}

.stage-tip {
  margin-bottom: 12rpx;
  font-size: 22rpx;
}

.dock {
  position: relative;
  z-index: 20;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.pop-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
}

.refs {
  white-space: nowrap;
  margin: 8rpx 0 16rpx;
}

.ref {
  position: relative;
  display: inline-block;
  width: 96rpx;
  height: 96rpx;
  margin: 12rpx 18rpx 0 0;
  vertical-align: top;
}

.ref image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
}

.ref-x {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--inverse);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.ref-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--muted);
  border-radius: 8rpx;
  color: var(--muted);
  font-size: 40rpx;
  box-sizing: border-box;
}

.quick-anchor {
  position: relative;
}

.quick {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  min-height: 76rpx;
  color: var(--muted);
  font-size: 24rpx;
  border-radius: 8rpx;
}

.quick-item.on {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.quick-photo {
  width: 30rpx;
  height: 26rpx;
}

.quick-photo::before {
  width: 5rpx;
  height: 5rpx;
  top: 4rpx;
  right: 4rpx;
}

.quick-photo::after {
  width: 22rpx;
  height: 22rpx;
  top: 15rpx;
}

.quick-symbol {
  font-size: 32rpx;
  line-height: 1;
}

.settings-symbol {
  font-size: 36rpx;
}

.pop {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  z-index: 21;
  margin-bottom: 12rpx;
  overflow-y: auto;
  box-shadow: 0 12rpx 40rpx var(--line);
}

.ideas {
  max-height: 440rpx;
  padding: 16rpx 24rpx;
}

.pop-label {
  display: block;
  padding: 10rpx 0;
  color: var(--muted);
  font-size: 20rpx;
}

.idea {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 25rpx;
}

.idea:last-child {
  border-bottom: none;
}

.idea-arrow {
  color: var(--brand);
}

.more {
  padding: 4rpx 24rpx;
}

.more-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.more-row:last-child {
  border-bottom: none;
}

.more-v {
  color: var(--brand);
}

.composer {
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--card);
  overflow: hidden;
}

.composer .area {
  height: 152rpx;
  min-height: 152rpx;
  border: none;
  padding: 22rpx 24rpx 8rpx;
  background: transparent;
  font-size: 27rpx;
}

.composer-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx 16rpx 24rpx;
}

.clear {
  padding: 14rpx 24rpx 14rpx 0;
  color: var(--muted);
  font-size: 24rpx;
}

.composer-actions .go {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin: 0;
  width: 260rpx;
  height: 76rpx;
  padding: 0 24rpx;
  background: var(--brand);
  color: var(--inverse);
  font-size: 26rpx;
}

.go-arrow {
  font-size: 32rpx;
  color: var(--inverse);
}

.poster-entry { padding: 14rpx 22rpx; background: var(--brand-soft); color: var(--brand-deep); font-size: 25rpx; text-align: left; flex-shrink: 0; }
.poster-entry text { display: block; }
.poster-entry text + text { font-size: 20rpx; margin-top: 4rpx; }
