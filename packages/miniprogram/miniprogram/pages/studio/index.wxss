@import "../../styles/generation-loading.wxss";

.studio {
  --muted: var(--muted-strong);
  display: flex;
  flex-direction: column;
}

.studio-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding: 40rpx 32rpx 24rpx;
}

.studio-heading .eyebrow {
  color: var(--brand-deep);
}

.studio-heading .h1 {
  margin-top: 8rpx;
  margin-bottom: 0;
  font-size: 44rpx;
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
}

.frame {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 16rpx;
}

/* Absorb spare viewport space while leaving the composer in normal flow. */
.frame-placeholder {
  flex: 1;
  min-height: 280rpx;
}

.frame-result {
  display: block;
}

.frame-img {
  display: block;
  width: 100%;
  height: auto;
  background: var(--surface);
}

.frame-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  text-align: center;
}

.canvas-art {
  position: relative;
  width: 104rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--line);
  transform: rotate(-7deg);
}

.art-sun {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--brand);
}

.art-hill {
  position: absolute;
  width: 160rpx;
  height: 130rpx;
  top: 64rpx;
  left: -28rpx;
  border-radius: 50% 50% 0 0;
  background: var(--poster-mint);
  transform: rotate(24deg);
}

.art-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 22rpx;
  background: var(--card);
}

.frame-title {
  font-size: 28rpx;
  font-weight: 500;
}

.frame-empty .muted {
  font-size: 22rpx;
}

.frame-busy {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: var(--bg);
}

.frame-progress {
  font-size: 64rpx;
  letter-spacing: 2rpx;
}

.frame-status {
  margin-top: 54rpx;
  font-size: 24rpx;
}

.stage-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 56rpx;
  gap: 16rpx;
}

.stage-meta .muted {
  font-size: 22rpx;
  color: var(--muted);
}

.stage-save {
  padding: 12rpx 0 12rpx 20rpx;
  color: var(--brand-deep);
  font-size: 24rpx;
}

.stage-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.dock {
  position: relative;
  z-index: 20;
  margin-top: 16rpx;
  /* The native tab bar already owns the bottom safe area. */
  padding: 0 32rpx 24rpx;
  background: var(--bg);
}

.pop-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
}

.refs {
  white-space: nowrap;
  margin: 8rpx 0 16rpx;
}

.ref {
  position: relative;
  display: inline-block;
  width: 96rpx;
  height: 96rpx;
  margin: 12rpx 18rpx 0 0;
  vertical-align: top;
}

.ref image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
}

.ref-x {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--inverse);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.ref-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--muted);
  border-radius: 8rpx;
  color: var(--muted);
  font-size: 40rpx;
  box-sizing: border-box;
}

.quick-anchor {
  position: relative;
}

.quick {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.quick-item {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 44px;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--muted);
  font-size: 22rpx;
  white-space: nowrap;
  border-radius: 48rpx;
}

.quick-item.on {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.tool-icon {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
}

.quick-photo::before {
  width: 5rpx;
  height: 5rpx;
  top: 4rpx;
  right: 4rpx;
}

.quick-photo::after {
  width: 22rpx;
  height: 22rpx;
  top: 15rpx;
}

.idea-mark::before {
  content: "";
  position: absolute;
  inset: 0 4rpx 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50% 50% 6rpx 6rpx;
}

.idea-mark::after {
  content: "";
  position: absolute;
  bottom: 2rpx;
  left: 9rpx;
  width: 10rpx;
  border-top: 2rpx solid currentColor;
}

.settings-mark > view {
  position: absolute;
  left: 0;
  right: 0;
  top: 7rpx;
  border-top: 2rpx solid currentColor;
}

.settings-mark > view + view {
  top: 21rpx;
}

.settings-mark > view::after {
  content: "";
  position: absolute;
  left: 6rpx;
  top: -5rpx;
  width: 6rpx;
  height: 6rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  background: var(--card);
}

.settings-mark > view + view::after {
  left: 16rpx;
}

.quick-item.on .settings-mark > view::after {
  background: var(--brand-soft);
}

.pop {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  z-index: 21;
  margin-bottom: 12rpx;
  overflow-y: auto;
  box-shadow: 0 12rpx 40rpx var(--line);
}

.ideas {
  max-height: 440rpx;
  padding: 16rpx 24rpx;
}

.pop-label {
  display: block;
  padding: 10rpx 0;
  color: var(--muted);
  font-size: 20rpx;
}

.idea {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 25rpx;
}

.idea:last-child {
  border-bottom: none;
}

.idea-arrow {
  color: var(--brand-deep);
}

.more {
  padding: 4rpx 24rpx;
}

.more-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.more-row:last-child {
  border-bottom: none;
}

.more-v {
  color: var(--brand-deep);
}

.composer {
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--card);
  overflow: hidden;
}

.composer .area {
  height: 136rpx;
  min-height: 136rpx;
  border: none;
  padding: 24rpx 24rpx 8rpx;
  background: transparent;
  font-size: 27rpx;
}

.composer-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 16rpx 16rpx 24rpx;
}

.clear {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding-right: 24rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.composer-actions .go {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 auto;
  width: 260rpx;
  height: 76rpx;
  min-height: 44px;
  padding: 0 24rpx;
  background: var(--brand-deep);
  color: var(--inverse);
  font-size: 26rpx;
}

.composer-actions .go[disabled] {
  background: var(--brand-soft);
  color: var(--muted);
  opacity: 1;
}

.poster-entry {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 16rpx 24rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 24rpx;
  flex-shrink: 0;
}
