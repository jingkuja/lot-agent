<view class="page studio">
  <view wx:if="{{showIdeas || showMore}}" class="pop-mask" catchtap="closePopovers"></view>
  <view class="studio-heading">
    <view>
      <text class="eyebrow">图片工作室</text>
      <text class="h1">让想法成像。</text>
    </view>
    <button class="poster-entry" bindtap="openPoster"><text>海报创作 ↗</text></button>
    <text class="ai-disclaimer">本服务为AI生成内容，结果仅供参考。</text>
  </view>
  <view class="stage">
    <view class="frame card {{resultUrl ? 'frame-result' : 'frame-placeholder'}}" bindtap="save">
      <image wx:if="{{resultUrl}}" class="frame-img" src="{{resultUrl}}" mode="widthFix" show-menu-by-longpress bindload="onImgLoad" binderror="onImgError" />
      <view wx:else class="frame-empty">
        <view class="canvas-art">
          <view class="art-sun"></view>
          <view class="art-hill"></view>
          <view class="art-caption"></view>
        </view>
        <text class="frame-title">下一张，从这里开始</text>
        <text class="muted">写下画面，或添一张参考图</text>
      </view>
      <view wx:if="{{busy}}" class="frame-busy">
        <view class="generation-grain"></view>
        <view class="generation-grain generation-grain-secondary"></view>
        <text class="generation-progress frame-progress">{{progress}}%</text>
        <text class="generation-status frame-status">{{statusText || '正在生成'}}</text>
      </view>
    </view>
    <view wx:if="{{resultUrl && !busy}}" class="stage-meta">
      <text class="muted">你的最新创作</text>
      <view class="stage-save" bindtap="save">保存 / 分享 ↗</view>
    </view>
    <view wx:if="{{statusText && !busy && !resultUrl}}" class="stage-tip muted">{{statusText}}</view>
  </view>
  <view class="dock">
    <scroll-view wx:if="{{refs.length}}" class="refs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="ref" wx:for="{{refs}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="ref-x" data-index="{{index}}" catchtap="removeRef">×</view>
      </view>
      <view class="ref ref-add" bindtap="addRef">＋</view>
    </scroll-view>
    <view class="quick-anchor">
      <view wx:if="{{showIdeas}}" class="pop ideas card">
        <text class="pop-label">从一个想法开始</text>
        <view class="idea" wx:for="{{ideas}}" wx:key="*this" data-text="{{item}}" catchtap="pickIdea">
          {{item}}
          <text class="idea-arrow">↗</text>
        </view>
      </view>
      <view wx:if="{{showMore}}" class="pop more card">
        <view class="more-row" catchtap="pickRatio">
          <text class="more-k">画面比例</text>
          <text class="more-v">{{ratioLabel}} ›</text>
        </view>
        <view class="more-row" catchtap="pickQuality">
          <text class="more-k">清晰度</text>
          <text class="more-v">{{qualityLabel}} ›</text>
        </view>
      </view>
      <view class="quick">
        <view class="quick-item {{refs.length ? 'on' : ''}}" bindtap="addRef">
          <view class="tool-icon photo-mark quick-photo" aria-hidden="true"></view>
          <text>{{refs.length ? '参考图 ' + refs.length : '参考图'}}</text>
        </view>
        <view class="quick-item {{showIdeas ? 'on' : ''}}" bindtap="toggleIdeas">
          <view class="tool-icon idea-mark" aria-hidden="true"></view>
          <text>灵感</text>
        </view>
        <view class="quick-item {{showMore ? 'on' : ''}}" bindtap="toggleMore">
          <view class="tool-icon settings-mark" aria-hidden="true"><view></view><view></view></view>
          <text>画面设置 · {{ratioLabel}}</text>
        </view>
      </view>
    </view>
    <view class="composer">
      <textarea class="area composer-input" value="{{prompt}}" maxlength="800" placeholder="描述你想要的画面，细节也可以慢慢补充…" placeholder-class="ph" bindinput="onPrompt" />
      <view class="composer-actions">
        <view wx:if="{{!busy && (prompt.length || refs.length || resultUrl)}}" class="clear" bindtap="newSheet">清空</view>
        <button size="mini" class="go" disabled="{{busy || !hasPrompt}}" bindtap="print">
          <text>{{busy ? '生成中' : '生成图片'}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
