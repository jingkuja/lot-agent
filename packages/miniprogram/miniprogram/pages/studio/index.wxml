<view class="page studio">
  <view wx:if="{{showIdeas || showMore}}" class="pop-mask" catchtap="closePopovers"></view>

  <!-- 结果区 -->
  <view class="stage">
    <view class="frame card" bindtap="save">
      <image wx:if="{{resultUrl}}" class="frame-img" src="{{resultUrl}}" mode="aspectFit" />
      <view wx:else class="frame-empty">
        <view class="frame-emoji">🎨</view>
        <text class="frame-title">开始你的创作</text>
        <text class="muted">传一张照片修一修,或写句话生成一张图</text>
      </view>
      <view wx:if="{{busy}}" class="frame-busy">
        <view class="dots">
          <view class="dot dot-1"></view>
          <view class="dot dot-2"></view>
          <view class="dot dot-3"></view>
          <view class="dot dot-4"></view>
          <view class="dot dot-5"></view>
        </view>
        <text class="frame-progress">{{progress}}%</text>
        <text class="frame-status">{{statusText || '正在生成'}}</text>
      </view>
    </view>

    <view wx:if="{{resultUrl && !busy}}" class="stage-actions">
      <view class="btn btn-primary stage-save" bindtap="save">保存 / 分享</view>
    </view>
    <view wx:elif="{{statusText && !busy}}" class="stage-tip muted">{{statusText}}</view>
  </view>

  <!-- 操作区 -->
  <view class="dock safe-bottom">
    <!-- 参考图 -->
    <scroll-view wx:if="{{refs.length}}" class="refs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="ref" wx:for="{{refs}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="ref-x" data-index="{{index}}" catchtap="removeRef">×</view>
      </view>
      <view class="ref ref-add" bindtap="addRef">＋</view>
    </scroll-view>

    <!-- 快捷入口；灵感 / 选项从按钮向上浮出，不占下方位置 -->
    <view class="quick-anchor">
      <view wx:if="{{showIdeas}}" class="pop ideas card">
        <view class="idea" wx:for="{{ideas}}" wx:key="*this" data-text="{{item}}" catchtap="pickIdea">{{item}}</view>
      </view>
      <view wx:if="{{showMore}}" class="pop more card">
        <view class="more-row" catchtap="pickRatio">
          <text class="more-k">画面比例</text>
          <text class="more-v">{{ratioLabel}} ›</text>
        </view>
        <view class="more-row" catchtap="pickQuality">
          <text class="more-k">清晰度</text>
          <text class="more-v">{{qualityLabel}} ›</text>
        </view>
      </view>
      <view class="quick">
        <view class="quick-item {{refs.length ? 'on' : ''}}" bindtap="addRef">
          <text class="quick-ico">🖼️</text>
          <text>{{refs.length ? '已选 ' + refs.length + ' 张' : '相册选图'}}</text>
        </view>
        <view class="quick-item {{showIdeas ? 'on' : ''}}" bindtap="toggleIdeas">
          <text class="quick-ico">💡</text>
          <text>灵感</text>
        </view>
        <view class="quick-item {{showMore ? 'on' : ''}}" bindtap="toggleMore">
          <text class="quick-ico">⚙️</text>
          <text>选项</text>
        </view>
      </view>
    </view>

    <!-- 输入 + 清空 / 生成 -->
    <view class="composer">
      <textarea
        class="area composer-input"
        value="{{prompt}}"
        maxlength="800"
        placeholder="想修哪里?或想要什么画面?"
        placeholder-class="ph"
        bindinput="onPrompt"
      />
      <view class="composer-actions">
        <view class="clear" bindtap="newSheet">
          <text class="clear-ico">⌫</text>
          <text>清空</text>
        </view>
        <view class="go {{busy ? 'going' : ''}}" bindtap="print">
          <text wx:if="{{!busy}}">✨ 生成</text>
          <text wx:else>…</text>
        </view>
      </view>
    </view>
  </view>
</view>
