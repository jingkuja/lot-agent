.video-studio { padding: 26rpx 30rpx 200rpx; }
.h1 { font-size: 44rpx; }
.steps { width: 100%; margin: 0 0 28rpx; white-space: nowrap; }
.steps-inner { display: inline-flex; gap: 24rpx; padding: 6rpx 0 18rpx; }
.step { display: flex; align-items: center; gap: 10rpx; color: var(--muted); font-size: 23rpx; }
.step-number { display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 50%; width: 40rpx; height: 40rpx; }
.step.active { color: var(--brand); font-weight: 600; }
.active .step-number { background: var(--brand); color: var(--inverse); border-color: var(--brand); }
.workspace { padding: 30rpx; min-height: 630rpx; }
.section-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.label { display: block; margin: 28rpx 0 16rpx; font-size: 26rpx; font-weight: 500; }
.input, .area { background: var(--bg); }
.input { height: 92rpx; }
.topic { height: 170rpx; }
.script { height: 340rpx; }
.write { margin-top: 20rpx; color: var(--brand-deep); }
.choices { display: flex; flex-wrap: wrap; gap: 16rpx; }
.option { padding: 20rpx 26rpx; border: 1rpx solid var(--line); font-size: 26rpx; color: var(--muted); background: var(--card); }
.option.selected { background: var(--brand-soft); border-color: var(--brand); color: var(--brand-deep); }
.model-list { display: flex; flex-direction: column; gap: 16rpx; }
.model { display: flex; justify-content: space-between; align-items: center; text-align: left; }
.model-name { font-weight: 600; }
.model-id { display: block; margin-top: 6rpx; font-size: 22rpx; overflow-wrap: anywhere; }
.hint { display: block; margin: 28rpx 0; color: var(--muted); font-size: 24rpx; line-height: 1.8; }
.reference { width: 100%; height: 260rpx; margin-bottom: 16rpx; }
.remove { color: var(--muted); padding: 16rpx; font-size: 24rpx; }
.switch-row { display: flex; justify-content: space-between; align-items: center; margin-top: 38rpx; }
.cover-preview { position: relative; height: 460rpx; border-radius: var(--radius); background: var(--poster-mint); overflow: hidden; margin-bottom: 24rpx; }
.cover-preview image { width: 100%; height: 100%; }
.cover-text { position: absolute; bottom: 30rpx; left: 24rpx; right: 24rpx; background: var(--card); padding: 24rpx; border-radius: var(--radius); }
.cover-text text { display: block; font-size: 32rpx; font-weight: 600; }
.cover-text text + text { font-size: 24rpx; font-weight: 400; margin-top: 12rpx; }
.ready { min-height: 300rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20rpx; text-align: center; }
.ready-mark { font-size: 90rpx; color: var(--brand); }
.result-video { width: 100%; height: 610rpx; background: var(--surface); border-radius: var(--radius); }
.publish { margin-top: 20rpx; }
.step-footer { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; gap: 24rpx; padding: 24rpx 30rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: var(--bg); border-top: 1rpx solid var(--line); }
.step-footer .btn { font-size: 25rpx; min-height: 80rpx; }
.progress-track { flex: 1; height: 8rpx; border-radius: 8rpx; background: var(--line); overflow: hidden; }
.progress-track view { height: 100%; background: var(--brand); }
