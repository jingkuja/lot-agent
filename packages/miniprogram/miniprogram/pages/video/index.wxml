<view class="page video-studio">
  <view class="page-heading"><text class="eyebrow">视频工作室</text><text class="h1">把灵感，拍成故事。</text><text class="muted">从一句文案，到你的下一条视频。</text></view>
  <scroll-view class="steps" scroll-x show-scrollbar="{{false}}" scroll-into-view="step-{{step}}" scroll-with-animation>
    <view class="steps-inner"><view id="step-{{index}}" class="step {{step === index ? 'active' : ''}}" wx:for="{{steps}}" wx:key="*this" data-step="{{index}}" bindtap="goStep"><text class="step-number">{{index + 1}}</text><text>{{item}}</text></view></view>
  </scroll-view>
  <view class="workspace card">
    <view class="section-top"><text class="h2">{{steps[step]}}</text><text class="muted">{{step + 1}} / 7</text></view>
    <view wx:if="{{step === 0}}">
      <text class="label">这次想拍什么</text><textarea class="area topic" value="{{draft.topic}}" data-field="topic" bindinput="field" maxlength="1000" placeholder="例如：为新开的咖啡店拍一条温暖的探店短片" disabled="{{busy || writing || pending}}" />
      <button class="btn btn-soft write" bindtap="writeCopy" loading="{{writing}}" disabled="{{writing || busy || pending}}">{{draft.script ? '重新生成文案与标题' : '生成文案与标题'}} ✧</button>
      <text class="label">视频文案 / 分镜</text><textarea class="area script" value="{{draft.script}}" data-field="script" bindinput="field" maxlength="4000" placeholder="也可以直接写下镜头、动作和旁白…" disabled="{{busy || writing || pending}}" />
    </view>
    <view wx:elif="{{step === 1}}">
      <button class="btn btn-soft" bindtap="writeCopy" disabled="{{writing || busy || pending}}" loading="{{writing}}">重新生成文案与标题 ✧</button>
      <text class="label">封面主标题</text><input class="input" value="{{draft.mainTitle}}" data-field="mainTitle" bindinput="field" maxlength="40" placeholder="让人一眼记住的标题" disabled="{{busy || pending}}" />
      <text class="label">封面副标题</text><input class="input" value="{{draft.subtitle}}" data-field="subtitle" bindinput="field" maxlength="60" placeholder="补充一个亮点" disabled="{{busy || pending}}" />
      <text class="label">视频发布标题</text><textarea class="area" value="{{draft.publishTitle}}" data-field="publishTitle" bindinput="field" maxlength="100" placeholder="发布时想说的话" disabled="{{busy || pending}}" />
      <text class="label">短视频检索标签</text><input class="input" value="{{draft.tags}}" data-field="tags" bindinput="field" maxlength="160" placeholder="#生活记录 #我的创作" disabled="{{busy || pending}}" />
    </view>
    <view wx:elif="{{step === 2}}"><text class="label">旁白风格</text><view class="choices"><button wx:for="{{voices}}" wx:key="*this" class="option {{draft.voice === item ? 'selected' : ''}}" data-field="voice" data-value="{{item}}" bindtap="choose">{{item}}</button></view><text class="hint">声音将随视频一起生成。实际音色与旁白效果取决于所选模型，请在发布前试听。</text></view>
    <view wx:elif="{{step === 3}}">
      <text class="label">选择模型</text><view class="model-list"><button wx:for="{{models}}" wx:key="id" class="model option {{draft.modelIndex === index ? 'selected' : ''}}" data-field="modelIndex" data-value="{{index}}" bindtap="choose"><view><text class="model-name">{{item.label}} · {{item.resolution}}</text><text class="model-id">{{item.id}}</text></view><text>{{draft.modelIndex === index ? '●' : '○'}}</text></button></view>
      <text class="label">画面比例</text><view class="choices"><button class="option {{draft.ratio === item ? 'selected' : ''}}" wx:for="{{ratios}}" wx:key="*this" data-field="ratio" data-value="{{item}}" bindtap="choose">{{item}}</button></view>
      <text class="label">视频时长</text><view class="choices"><button class="option {{draft.durationSec === item ? 'selected' : ''}}" wx:for="{{durations}}" wx:key="*this" data-field="durationSec" data-value="{{item}}" bindtap="choose">{{item}} 秒</button></view>
      <text class="label">参考图（选填）</text><image wx:if="{{draft.reference}}" class="reference" src="{{draft.reference}}" mode="aspectFit" /><button class="btn btn-soft" data-field="reference" bindtap="chooseImage">{{draft.reference ? '更换参考图' : '＋ 添加参考图'}}</button><button wx:if="{{draft.reference}}" class="remove" data-field="reference" bindtap="removeImage">移除参考图</button>
    </view>
    <view wx:elif="{{step === 4}}"><text class="label">背景音乐</text><view class="choices"><button class="option {{draft.bgm === item ? 'selected' : ''}}" wx:for="{{music}}" wx:key="*this" data-field="bgm" data-value="{{item}}" bindtap="choose">{{item}}</button></view><view class="switch-row"><text>中文字幕</text><switch checked="{{draft.subtitles}}" bindchange="toggleSubtitles" disabled="{{busy || pending}}" /></view><text class="hint">配乐与字幕作为创作要求随视频生成，暂不支持生成后单独混音或修改字幕；发布前请检查文字和声音。</text></view>
    <view wx:elif="{{step === 5}}"><text class="label">开场封面</text><view class="cover-preview"><image wx:if="{{draft.cover || draft.reference}}" src="{{draft.cover || draft.reference}}" mode="aspectFill" /><view class="cover-text"><text>{{draft.mainTitle || '你的故事，即将开场'}}</text><text>{{draft.subtitle || '用一句话，留下第一印象'}}</text></view></view><button class="btn btn-soft" data-field="cover" bindtap="chooseImage">{{draft.cover ? '更换封面图' : '＋ 选择封面图'}}</button><button wx:if="{{draft.cover}}" class="remove" data-field="cover" bindtap="removeImage">移除封面图</button><text class="hint">此处为封面示意。选择封面图后将替代参考图作为视频首帧；标题交给模型生成，最终效果以成片为准。</text></view>
    <view wx:elif="{{step === 6}}"><video wx:if="{{resultUrl}}" class="result-video" src="{{resultUrl}}" controls show-center-play-btn /><view wx:else class="ready"><text class="ready-mark">▷</text><text class="h2">{{pending ? '你的故事正在成片' : '准备好，让故事动起来'}}</text><text class="muted">{{models[draft.modelIndex].label}} · {{models[draft.modelIndex].resolution}} · {{draft.ratio}} · {{draft.durationSec}} 秒</text></view><text class="hint">{{status || '确认前面的创作设置后生成视频。生成将消耗账户积分。'}}</text><button wx:if="{{pending}}" class="btn btn-soft" bindtap="checkTask">查询进度</button><button wx:else class="btn btn-primary" loading="{{busy}}" disabled="{{busy || writing}}" bindtap="generate">{{resultUrl ? '按当前设置重新生成' : '生成视频'}} ↗</button><button wx:if="{{resultUrl}}" class="btn btn-soft publish" bindtap="openResult">发布 / 分享 / 保存 ↗</button><text wx:if="{{resultUrl}}" class="hint">抖音 · 小红书 · 微信好友 · 朋友圈 · 保存相册</text><button class="remove" bindtap="newDraft" disabled="{{busy || writing}}">开始新视频</button></view>
  </view>
  <view class="step-footer safe-bottom"><button class="btn btn-ghost" bindtap="previous" disabled="{{step === 0}}">‹ 上一步</button><view class="progress-track"><view style="width: {{(step + 1) / 7 * 100}}%"></view></view><button class="btn btn-primary" bindtap="next" disabled="{{step === 6 || writing}}">下一步 ›</button></view>
</view>
