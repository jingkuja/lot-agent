<view class="page video-studio">
  <view class="page-heading"><text class="eyebrow">视频工作室</text><text class="h1">把灵感，拍成故事。</text><text class="muted">从一句文案，到你的下一条视频。</text></view>
  <scroll-view class="steps" scroll-x show-scrollbar="{{false}}" scroll-into-view="step-{{step}}" scroll-with-animation>
    <view class="steps-inner"><view id="step-{{index}}" class="step {{locked ? 'locked' : ''}} {{step === index ? 'active' : ''}} {{index < step ? 'done' : ''}}" wx:for="{{steps}}" wx:key="*this" data-step="{{index}}" bindtap="goStep"><text class="step-number">{{index + 1}}</text><text>{{item}}</text></view></view>
  </scroll-view>
  <view class="workspace card">
    <view class="section-top"><text class="h2">{{steps[step]}}</text><text class="muted">{{step + 1}} / {{steps.length}}</text></view>
    <view wx:if="{{step === 0}}">
      <text class="label">这次想拍什么</text><textarea class="area topic" value="{{draft.topic}}" data-field="topic" bindinput="field" maxlength="1000" placeholder="例如：为新开的咖啡店拍一条温暖的探店短片" disabled="{{locked}}" />
      <button class="btn btn-soft write" bindtap="writeCopy" loading="{{writing}}" disabled="{{locked}}">{{draft.script ? '重新生成文案与标题' : '生成文案与标题'}} ✧</button>
      <text wx:if="{{copyError}}" class="error">{{copyError}}</text>
      <text class="label">视频文案 / 分镜</text><textarea class="area script" value="{{draft.script}}" data-field="script" bindinput="field" maxlength="4000" placeholder="也可以直接写下镜头、动作和旁白…" disabled="{{locked}}" />
    </view>
    <view wx:elif="{{step === 1}}">
      <button class="btn btn-soft" bindtap="writeCopy" disabled="{{locked}}" loading="{{writing}}">重新生成文案与标题 ✧</button>
      <text wx:if="{{copyError}}" class="error">{{copyError}}</text>
      <text class="label">封面主标题</text><input class="input" value="{{draft.mainTitle}}" data-field="mainTitle" bindinput="field" maxlength="40" placeholder="让人一眼记住的标题" disabled="{{locked}}" />
      <text class="label">封面副标题</text><input class="input" value="{{draft.subtitle}}" data-field="subtitle" bindinput="field" maxlength="60" placeholder="补充一个亮点" disabled="{{locked}}" />
      <text class="label">视频发布标题</text><textarea class="area" value="{{draft.publishTitle}}" data-field="publishTitle" bindinput="field" maxlength="100" placeholder="发布时想说的话" disabled="{{locked}}" />
      <text class="label">短视频检索标签</text><input class="input" value="{{draft.tags}}" data-field="tags" bindinput="field" maxlength="160" placeholder="#生活记录 #我的创作" disabled="{{locked}}" />
      <text class="hint">发布标题和标签只用于分享，不影响视频生成；修改后无需重新付费。</text>
    </view>
    <view wx:elif="{{step === 2}}"><text class="label">旁白风格</text><view class="choices"><button wx:for="{{voices}}" wx:key="*this" class="option {{draft.voice === item ? 'selected' : ''}}" data-field="voice" data-value="{{item}}" bindtap="choose" disabled="{{locked}}">{{item}}</button></view><text class="hint">声音将随视频一起生成。实际音色与旁白效果取决于所选模型，请在发布前试听。</text></view>
    <view wx:elif="{{step === 3}}">
      <text class="label">选择模型</text><view class="model-list"><button wx:for="{{models}}" wx:key="id" class="model option {{draft.modelIndex === index ? 'selected' : ''}}" data-field="modelIndex" data-value="{{index}}" bindtap="choose" disabled="{{locked}}"><view><text class="model-name">{{item.label}} · {{item.resolution}}</text><text class="model-id">{{item.description}}</text></view><text>{{draft.modelIndex === index ? '●' : '○'}}</text></button></view>
      <text class="label">画面比例</text><view class="choices"><button class="option {{draft.ratio === item ? 'selected' : ''}}" wx:for="{{ratios}}" wx:key="*this" data-field="ratio" data-value="{{item}}" bindtap="choose" disabled="{{locked}}">{{item}}</button></view>
      <text class="label">视频时长</text><view class="choices"><button class="option {{draft.durationSec === item ? 'selected' : ''}}" wx:for="{{durations}}" wx:key="*this" data-field="durationSec" data-value="{{item}}" bindtap="choose" disabled="{{locked}}">{{item}} 秒</button></view>
      <text class="label">参考图（选填）</text><image wx:if="{{draft.reference}}" class="reference" src="{{draft.reference}}" mode="aspectFit" /><button class="btn btn-soft" data-field="reference" bindtap="chooseImage" disabled="{{locked}}">{{draft.reference ? '更换参考图' : '＋ 添加参考图'}}</button><button wx:if="{{draft.reference}}" class="remove" data-field="reference" bindtap="removeImage" disabled="{{locked}}">移除参考图</button>
    </view>
    <view wx:elif="{{step === 4}}"><text class="label">背景音乐</text><view class="choices"><button class="option {{draft.bgm === item ? 'selected' : ''}}" wx:for="{{music}}" wx:key="*this" data-field="bgm" data-value="{{item}}" bindtap="choose" disabled="{{locked}}">{{item}}</button></view><view class="switch-row"><text>中文字幕</text><switch checked="{{draft.subtitles}}" bindchange="toggleSubtitles" disabled="{{locked}}" /></view><text class="hint">配乐与字幕作为创作要求随视频生成，暂不支持生成后单独混音或修改字幕；发布前请检查文字和声音。</text></view>
    <view wx:elif="{{step === 5}}"><text class="label">开场封面</text><view class="cover-preview"><image wx:if="{{draft.cover || draft.reference}}" src="{{draft.cover || draft.reference}}" mode="aspectFill" /><view class="cover-text"><text>{{draft.mainTitle || '你的故事，即将开场'}}</text><text>{{draft.subtitle || '用一句话，留下第一印象'}}</text></view></view><button class="btn btn-soft" data-field="cover" bindtap="chooseImage" disabled="{{locked}}">{{draft.cover ? '更换封面图' : '＋ 选择封面图'}}</button><button wx:if="{{draft.cover}}" class="remove" data-field="cover" bindtap="removeImage" disabled="{{locked}}">移除封面图</button><text class="hint">此处为封面示意。选择封面图后将替代参考图作为视频首帧；标题交给模型生成，最终效果以成片为准。</text></view>
    <view wx:elif="{{step === lastStep}}">
      <video wx:if="{{resultUrl}}" class="result-video" src="{{resultUrl}}" controls show-center-play-btn />
      <view wx:else class="ready">
        <text class="ready-mark {{pending || busy ? 'working' : ''}}">{{pending || busy ? '◷' : '▷'}}</text>
        <text class="h2">{{pending ? '你的故事正在成片' : (busy ? '正在准备提交' : (downloadFailed ? '成片等待下载' : '准备好，让故事动起来'))}}</text>
        <text wx:if="{{pending}}" class="muted">{{elapsed || '任务已保留'}} · 无需停留在此页面</text>
      </view>
      <view class="brief">
        <view class="brief-row"><text>模型与画面</text><text>{{models[draft.modelIndex].label}} · {{models[draft.modelIndex].resolution}}</text></view>
        <view class="brief-row"><text>比例与时长</text><text>{{draft.ratio}} · {{draft.durationSec}} 秒</text></view>
        <view class="brief-row"><text>声音与配乐</text><text>{{draft.voice}} · {{draft.bgm}}</text></view>
        <view class="brief-row"><text>字幕与首帧</text><text>{{draft.subtitles ? '中文字幕' : '无字幕'}} · {{draft.cover ? '封面图' : (draft.reference ? '参考图' : '无图片')}}</text></view>
      </view>
      <view wx:if="{{pending}}" class="task-notice">
        <text class="notice-title">{{status || '正在恢复任务进度'}}</text>
        <text>视频制作可能需要数分钟，请勿重复提交。切换页面或关闭小程序后，回来会继续查询。</text>
        <text>为避免重复消耗积分，当前任务完成前暂不能修改设置或开始新视频。</text>
      </view>
      <text wx:else class="hint">{{status || '请检查以上设置。视频生成将消耗账户积分，耗时可能较长。'}}</text>
      <button wx:if="{{pending}}" class="btn btn-soft" bindtap="checkTask" loading="{{checking}}" disabled="{{checking || busy}}">{{checking ? '正在查询' : '刷新进度'}}</button>
      <button wx:elif="{{!downloadFailed}}" class="btn {{resultUrl ? 'btn-soft' : 'btn-primary'}}" loading="{{busy}}" disabled="{{locked || unchanged}}" bindtap="generate">{{unchanged ? '当前设置已生成' : (resultUrl ? '按修改后的设置生成' : '确认设置并生成视频')}} ↗</button>
      <text wx:if="{{unchanged && resultUrl}}" class="hint">成片已保留，可直接保存或分享。需要调整效果时，请先返回修改创作设置。</text>
      <button wx:if="{{resultUrl}}" class="btn btn-primary publish" bindtap="openResult" disabled="{{busy}}">发布 / 分享 / 保存 ↗</button>
      <text wx:if="{{resultUrl}}" class="hint">抖音 · 小红书 · 微信好友 · 朋友圈 · 保存相册</text>
      <button wx:if="{{pending && stale}}" class="remove" bindtap="stopWaiting" disabled="{{busy || checking}}">等太久了？不再等待，去看「作品」</button>
      <button wx:else class="remove" bindtap="newDraft" disabled="{{locked}}">开始新视频</button>
    </view>
  </view>
  <view class="step-footer safe-bottom"><button class="btn btn-ghost" bindtap="previous" disabled="{{step === 0 || locked}}">‹ 上一步</button><view class="progress-track"><view style="width: {{(step + 1) / steps.length * 100}}%"></view></view><button class="btn btn-primary" bindtap="next" disabled="{{step === lastStep || locked}}">{{step === lastStep - 1 ? '检查生成设置' : '下一步'}} ›</button></view>
</view>
