<view class="page mine">
  <view class="page-heading"><text class="eyebrow">个人空间</text><text class="h1">我的创作日常</text></view>
  <!-- 用户卡 -->
  <view class="user card">
    <view class="avatar">{{initial}}</view>
    <view class="who">
      <view wx:if="{{!editingName}}" class="name-row" bindtap="startEditName">
        <text class="name">{{user ? (user.name || user.username) : '未登录'}}</text>
        <text wx:if="{{user}}" class="edit-hint">修改</text>
      </view>
      <view wx:else class="name-edit">
        <input
          class="name-input"
          value="{{nameDraft}}"
          maxlength="20"
          focus
          confirm-type="done"
          bindinput="onNameDraft"
          bindconfirm="saveName"
        />
        <text class="edit-hint" bindtap="saveName">保存</text>
      </view>
      <text class="muted">{{user.phone || user.username || '欢迎使用'}}</text>
    </view>
    <button
      wx:if="{{user && !user.phone}}"
      size="mini"
      class="bind-phone"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{bindingPhone}}"
    >绑定手机号</button>
  </view>

  <text class="account-tip muted">{{user.phone ? '在网页使用同一手机号登录，可查看同一账户的数据和积分。' : '绑定网页账户使用的手机号，可将两端数据归到同一账户。'}}</text>

  <!-- 积分 -->
  <view class="stat card">
    <view class="stat-main">
      <view class="stat-l">
        <text class="stat-label">剩余积分</text>
        <view class="stat-num">
          <text class="points">{{balanceText}}</text>
          <text class="stat-unit">积分</text>
        </view>
      </view>
      <button size="mini" class="recharge-btn" bindtap="goRecharge">充值</button>
    </view>
    <text wx:if="{{fallbackState === 'enabled'}}" class="stat-fallback muted">积分不足时使用灵渠 AI 余额</text>
  </view>

  <text class="section-label">常用入口</text>
  <view class="menu card">
    <view class="mrow" bindtap="goStudio">
      <text class="mico">01</text>
      <text class="mtitle">图片工作室</text>
      <text class="marrow">›</text>
    </view>
    <view class="mrow" bindtap="goPoster">
      <text class="mico">02</text>
      <text class="mtitle">海报灵感</text>
      <text class="marrow">›</text>
    </view>
    <view class="mrow" bindtap="goGallery">
      <text class="mico">03</text>
      <text class="mtitle">我的作品</text>
      <text class="marrow">›</text>
    </view>
    <view class="mrow" bindtap="goAbout">
      <text class="mico">04</text>
      <text class="mtitle">了解更多 · 灵渠claw</text>
      <text class="marrow">›</text>
    </view>
  </view>
</view>
