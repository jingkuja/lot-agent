.mine {
  padding: 16rpx 32rpx 48rpx;
}

.mine .h1 {
  font-size: 40rpx;
}

.user {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 0;
  border: none;
  background: transparent;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 36rpx;
  font-weight: 500;
}

.who {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 180rpx;
}

.who .muted {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
}

.name-row, .name-edit {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.name {
  min-width: 0;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid var(--brand);
  font-size: 30rpx;
}

.edit-hint {
  flex-shrink: 0;
  padding: 12rpx 0;
  color: var(--brand-deep);
  font-size: 22rpx;
}

.user .bind-phone {
  width: auto;
  flex-shrink: 0;
  padding: 0 18rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  font-size: 22rpx;
}

.account-tip {
  display: block;
  padding: 0 0 28rpx;
  font-size: 22rpx;
}

.stat {
  position: relative;
  padding: 30rpx;
  background: var(--brand-soft);
  border-color: transparent;
}

.stat-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.stat-l {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 16rpx;
}

.stat-label {
  color: var(--ink);
  font-size: 24rpx;
}

.stat-num {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.points {
  max-width: 100%;
  word-break: break-all;
  color: var(--ink);
  font-size: 64rpx;
  font-weight: 500;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-unit {
  color: var(--muted);
  font-size: 22rpx;
}

.stat-main .recharge-btn {
  width: 144rpx;
  flex-shrink: 0;
  padding: 0 30rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  background: var(--card);
  color: var(--brand-deep);
  font-size: 26rpx;
}

.stat-fallback {
  display: block;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
}

.menu {
  padding: 0 24rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 108rpx;
  border-bottom: 1rpx solid var(--line);
}

.mrow:last-child {
  border-bottom: none;
}

.mico {
  color: var(--brand);
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.mtitle {
  flex: 1;
  font-size: 27rpx;
}

.marrow {
  color: var(--muted);
  font-size: 32rpx;
}
