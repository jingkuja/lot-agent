.mine {
  padding: 24rpx;
}

.user {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 32rpx 28rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand) 0%, var(--peach) 100%);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
}

.who {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 38rpx;
  font-weight: 700;
}

.stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 32rpx 28rpx;
}

.stat-l {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stat-label {
  color: var(--muted);
  font-size: 24rpx;
}

.points {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-deep);
  font-variant-numeric: tabular-nums;
}

.stat-emoji {
  font-size: 84rpx;
}

.menu {
  margin-top: 20rpx;
  padding: 4rpx 28rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.mrow:last-child {
  border-bottom: none;
}

.mico {
  font-size: 36rpx;
}

.mtitle {
  flex: 1;
  font-size: 30rpx;
}

.marrow {
  max-width: 320rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.server-edit {
  margin-top: 20rpx;
  gap: 16rpx;
}

.logout {
  width: 100%;
  margin-top: 40rpx;
}
