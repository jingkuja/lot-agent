.mine {
  padding: 24rpx;
}

.account-tip { display: block; padding: 18rpx 8rpx 0; font-size: 24rpx; line-height: 1.6; }
.stat-fallback { display: block; margin-top: 20rpx; font-size: 24rpx; line-height: 1.5; }

.user {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 32rpx 28rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand) 0%, var(--peach) 100%);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
}

.who {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.bind-phone {
  flex-shrink: 0;
  margin: 0;
  padding: 0 20rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.bind-phone::after {
  border: none;
}

.name-row,
.name-edit {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.name {
  min-width: 0;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.edit-hint {
  flex-shrink: 0;
  color: var(--brand-deep);
  font-size: 22rpx;
  font-weight: 600;
}

.stat {
  margin-top: 20rpx;
  padding: 36rpx 28rpx;
}

.stat-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.stat-l {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}

.recharge-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 48rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(240, 67, 106, 0.28);
}

.recharge-btn::after {
  border: none;
}

.stat-label {
  color: var(--muted);
  font-size: 24rpx;
}

.stat-num {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.points {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--brand-deep);
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
}

.stat-emoji {
  font-size: 36rpx;
  line-height: 1;
  transform: translateY(-4rpx);
}

.menu {
  margin-top: 20rpx;
  padding: 4rpx 28rpx;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.mrow:last-child {
  border-bottom: none;
}

.mico {
  font-size: 36rpx;
}

.mtitle {
  flex: 1;
  font-size: 30rpx;
}

.marrow {
  max-width: 320rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
