<view class="page edit">
  <view class="head">
    <text class="h1">以图修图</text>
    <text class="muted">放入原片,告诉我哪里要改</text>
  </view>

  <view class="drop card" bindtap="addRef">
    <view class="thumbs" wx:if="{{refs.length}}">
      <view class="thumb" wx:for="{{refs}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="x" data-index="{{index}}" catchtap="removeRef">×</view>
      </view>
      <view class="thumb add">＋</view>
    </view>
    <view wx:else class="drop-empty">
      <text class="drop-emoji">📷</text>
      <text class="muted">点这里放入照片</text>
    </view>
  </view>

  <textarea
    class="area prompt"
    placeholder="例如:换成夜景、去掉路人、保留我的脸"
    placeholder-class="ph"
    value="{{prompt}}"
    bindinput="onPrompt"
  />

  <view class="row">
    <button class="btn btn-primary" loading="{{busy}}" bindtap="print">✨ 开始修</button>
    <button class="btn btn-ghost" bindtap="sendToStudio">去修图页细调</button>
  </view>

  <view wx:if="{{statusText}}" class="muted status">{{statusText}}</view>
  <image wx:if="{{resultUrl}}" class="result card" src="{{resultUrl}}" mode="widthFix" bindtap="preview" />
</view>
