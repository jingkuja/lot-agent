.edit {
  padding: 24rpx;
}

.head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.drop {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  margin-bottom: 20rpx;
}

.drop-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 60rpx 0;
}

.drop-emoji {
  font-size: 96rpx;
}

.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 20rpx;
}

.thumb {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.thumb image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
}

.thumb.add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e5d8d2;
  border-radius: 20rpx;
  color: var(--muted);
  font-size: 52rpx;
}

.x {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  text-align: center;
  line-height: 36rpx;
}

.prompt {
  margin-bottom: 8rpx;
}

.ph {
  color: #c6bab4;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.row .btn {
  flex: 1;
}

.status {
  margin-top: 16rpx;
  text-align: center;
}

.result {
  width: 100%;
  margin-top: 24rpx;
  background: #f6efe9;
}
