.edit {
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.drop {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  margin-bottom: 24rpx;
  border-style: dashed;
  border-color: var(--muted);
}

.drop-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 60rpx 0;
  color: var(--brand);
}

.drop-empty .photo-mark {
  width: 64rpx;
  height: 52rpx;
}

.drop-empty .photo-mark::after {
  width: 46rpx;
  height: 46rpx;
  top: 30rpx;
}

.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 24rpx;
}

.thumb {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.thumb image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
}

.thumb.add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--line);
  border-radius: 10rpx;
  color: var(--muted);
  font-size: 40rpx;
  box-sizing: border-box;
}

.x {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--inverse);
  text-align: center;
  line-height: 40rpx;
}

.prompt {
  height: 220rpx;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.row .btn {
  flex: 1;
  padding: 0 12rpx;
  font-size: 25rpx;
}

.status {
  margin-top: 20rpx;
  text-align: center;
}

.result {
  width: 100%;
  margin-top: 24rpx;
  background: var(--surface);
}
