.about {
  padding: 24rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}

.intro {
  padding: 28rpx 0 32rpx;
  border: none;
  background: transparent;
}

.heading {
  margin: 20rpx 0 28rpx;
  max-width: 520rpx;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.4;
}

.description {
  display: block;
  margin: 20rpx 0;
  font-size: 26rpx;
  line-height: 1.85;
}

.destination {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
}

.url {
  display: block;
  margin: 16rpx 0;
  word-break: break-all;
  color: var(--brand-deep);
  font-size: 26rpx;
}

.destination .muted {
  font-size: 23rpx;
}

.destination .btn {
  margin-top: 28rpx;
}

.save-poster {
  width: 100%;
}

.poster-note {
  display: block;
  padding: 20rpx 0;
  font-size: 22rpx;
}

.poster-canvas {
  position: fixed;
  left: -10000px;
  top: 0;
}
