.preview {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 8rpx;
}

.hero {
  width: 100%;
  height: 760rpx;
  background: #f6efe9;
}

.tip {
  font-size: 22rpx;
}
.share-error { width: 100%; box-sizing: border-box; padding: 40rpx; text-align: center; line-height: 1.8; }
.share-error button { margin-top: 24rpx; }
.work-title { font-size: 28rpx; line-height: 1.6; word-break: break-all; }
.revoke { background: transparent; color: var(--muted); font-size: 24rpx; margin-top: 12rpx; }
.revoke::after { border: none; }

.panel {
  padding: 22rpx 24rpx 6rpx;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 30rpx rgba(90, 60, 70, 0.06);
}

.main {
  width: 100%;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.half {
  flex: 1;
}

.full {
  width: 100%;
  margin-top: 16rpx;
}

.note {
  display: block;
  margin: 16rpx 0 4rpx;
  text-align: center;
  font-size: 20rpx;
}
