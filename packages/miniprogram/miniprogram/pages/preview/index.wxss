.preview {
  display: flex;
  flex-direction: column;
}

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 24rpx 32rpx;
}

.hero {
  width: 100%;
  height: 680rpx;
  background: var(--surface);
  border: none;
  border-radius: 12rpx;
}

.tip {
  font-size: 21rpx;
}

.share-error {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx;
  text-align: center;
  line-height: 1.8;
}

.share-error button {
  margin-top: 24rpx;
}

.work-title {
  width: 100%;
  padding: 8rpx 8rpx 0;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.panel {
  padding: 28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--card);
}

.main {
  width: 100%;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.half {
  flex: 1;
  min-width: 0;
  padding: 0 10rpx;
  font-size: 25rpx;
}

.full {
  width: 100%;
  margin-top: 16rpx;
}

.revoke {
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 16rpx;
  padding: 12rpx;
}

.note {
  display: block;
  margin: 20rpx 0 0;
  text-align: left;
  font-size: 20rpx;
}
