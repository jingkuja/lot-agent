.recharge {
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.recharge .h1 {
  font-size: 40rpx;
}

.bal {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
  border: none;
  background: var(--surface);
}

.bal-l {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.bal-label {
  color: var(--muted);
  font-size: 22rpx;
}

.bal-value {
  font-size: 64rpx;
  font-weight: 500;
  line-height: 1.1;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

.bal-l .muted, .bal-unit {
  color: var(--muted);
  font-size: 22rpx;
}

.sect {
  margin-top: 36rpx;
}

.sect-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 27rpx;
  font-weight: 500;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.tier {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 28rpx 8rpx 22rpx;
  border-radius: 14rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  box-sizing: border-box;
}

.tier-on {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.tier-points {
  font-size: 34rpx;
  font-weight: 600;
}

.tier-label {
  font-size: 20rpx;
  color: var(--muted);
}

.tier-price {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--brand-deep);
}

.tier-discount {
  position: absolute;
  top: -14rpx;
  right: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 5rpx;
  background: var(--brand);
  color: var(--inverse);
  font-size: 18rpx;
}

.note {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-width: 1rpx 0 0;
  border-radius: 0;
  background: transparent;
}

.note-line {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.pay-btn {
  margin-top: 24rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--brand);
  color: var(--inverse);
  font-size: 28rpx;
  font-weight: 500;
}
