.login {
  padding: 100rpx 44rpx 44rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 64rpx;
  text-align: center;
}

.logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 12rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--peach) 100%);
  font-size: 64rpx;
  box-shadow: 0 16rpx 36rpx rgba(240, 67, 106, 0.28);
}

.tabs {
  display: flex;
  gap: 36rpx;
  margin-bottom: 32rpx;
}

.tab {
  padding-bottom: 10rpx;
  color: var(--muted);
  font-size: 30rpx;
}

.tab.on {
  color: var(--brand-deep);
  font-weight: 700;
  box-shadow: inset 0 -6rpx 0 var(--brand);
}

.form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.code-row .input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.code-btn.off {
  background: var(--line);
  color: var(--muted);
}

.ph {
  color: #c6bab4;
}

.err {
  display: block;
  margin: 20rpx 0 0;
  color: var(--brand-deep);
  font-size: 24rpx;
}

.enter {
  width: 100%;
  margin-top: 36rpx;
}

.server {
  margin-top: 48rpx;
  font-size: 20rpx;
  text-align: center;
}

.server-edit {
  margin-top: 20rpx;
  gap: 16rpx;
}
