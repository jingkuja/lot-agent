<view class="page login">
  <view class="brand">
    <view class="logo">✨</view>
    <text class="h1">美图海报</text>
    <text class="muted">修图 · 做海报 · 一键保存分享</text>
  </view>

  <view class="tabs">
    <view class="tab {{method === 'phone' ? 'on' : ''}}" bindtap="usePhone">手机号登录</view>
    <view class="tab {{method === 'password' ? 'on' : ''}}" bindtap="usePassword">账号密码</view>
  </view>

  <view wx:if="{{method === 'phone'}}" class="form">
    <view class="field">
      <text>手机号</text>
      <input class="input" type="number" maxlength="11" data-key="phone" value="{{phone}}" bindinput="onField" placeholder="请输入 11 位手机号" placeholder-class="ph" />
    </view>
    <view class="field">
      <text>验证码</text>
      <view class="code-row">
        <input class="input" type="number" maxlength="8" data-key="code" value="{{code}}" bindinput="onField" placeholder="短信验证码" placeholder-class="ph" />
        <view class="code-btn {{countdown ? 'off' : ''}}" bindtap="sendCode">{{countdown ? countdown + 's' : '获取验证码'}}</view>
      </view>
    </view>
  </view>

  <view wx:else class="form">
    <view class="field">
      <text>用户名</text>
      <input class="input" data-key="username" value="{{username}}" bindinput="onField" placeholder="Lot Agent 账号" placeholder-class="ph" />
    </view>
    <view class="field">
      <text>密码</text>
      <input class="input" password data-key="password" value="{{password}}" bindinput="onField" placeholder="请输入密码" placeholder-class="ph" />
    </view>
  </view>

  <text wx:if="{{error}}" class="err">{{error}}</text>
  <button class="btn btn-primary enter" loading="{{loading}}" bindtap="submit">进入</button>

  <view class="server muted" bindtap="toggleServer">服务器 {{apiBase}}</view>
  <view wx:if="{{showServer}}" class="field server-edit">
    <input class="input" data-key="apiBase" value="{{apiBase}}" bindinput="onField" />
    <button class="btn btn-ghost" bindtap="saveServer">保存地址</button>
  </view>
</view>
