.gallery {
  padding: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 140rpx 40rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 110rpx;
}

.empty-btn {
  width: 50%;
  margin-top: 20rpx;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.wall {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.cell {
  min-width: 0;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.cell:active {
  transform: scale(0.98);
}

.cell-generating:active {
  transform: none;
}

.cell image,
.cell-empty,
.cell-busy {
  width: 100%;
  height: 300rpx;
  background: #f6efe9;
}

.cell-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 22rpx;
}

/* 生成中封面:波点 + 居中百分比,不可点击 */
.cell-busy {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background: linear-gradient(135deg, #fdf2f4 0%, #f9ecef 100%);
}

.cell-busy .dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 44rpx;
}

.cell-busy .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand);
  animation: dot-pulse 1.4s ease-in-out infinite;
}

.cell-busy .dot-1 { animation-delay: 0s; }
.cell-busy .dot-2 { animation-delay: 0.15s; }
.cell-busy .dot-3 { animation-delay: 0.3s; }
.cell-busy .dot-4 { animation-delay: 0.45s; }
.cell-busy .dot-5 { animation-delay: 0.6s; }

@keyframes dot-pulse {
  0%, 100% {
    transform: scale(0.6);
    opacity: 0.35;
  }
  50% {
    transform: scale(1.25);
    opacity: 1;
  }
}

.cell-progress {
  color: var(--brand-deep);
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
  line-height: 1.1;
}

.cell-status {
  color: var(--muted);
  font-size: 20rpx;
}

.cell-title {
  display: block;
  padding: 14rpx 18rpx 18rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more {
  padding: 32rpx 0 60rpx;
  text-align: center;
}
