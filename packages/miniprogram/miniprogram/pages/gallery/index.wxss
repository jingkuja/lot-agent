@import "../../styles/generation-loading.wxss";

.gallery {
  padding: 16rpx 32rpx 40rpx;
}

.heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.heading-row .h1 {
  font-size: 38rpx;
}

.new-work {
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 16rpx;
  color: var(--brand-deep);
  font-size: 24rpx;
}

.collection-bar {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 0 24rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 21rpx;
}

.wall {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 28rpx 18rpx;
}

.cell {
  min-width: 0;
  overflow: hidden;
}

.cell:active {
  opacity: 0.8;
}

.cell-generating:active {
  opacity: 1;
}

.cell image, .cell-empty, .cell-busy {
  display: block;
  width: 100%;
  height: 350rpx;
  background: var(--surface);
  border-radius: 12rpx;
}

.cell-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 22rpx;
}

.cell-busy {
  position: relative;
  overflow: hidden;
  background: var(--surface);
}

.cell-progress {
  font-size: 44rpx;
  letter-spacing: 1rpx;
}

.cell-status {
  margin-top: 40rpx;
  font-size: 20rpx;
}

.cell-caption {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 2rpx;
}

.cell-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-arrow {
  color: var(--muted);
  font-size: 22rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 210rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--card);
  transform: rotate(-8deg);
  color: var(--brand);
}

.empty-art .photo-mark {
  width: 74rpx;
  height: 60rpx;
}

.empty-art .photo-mark::after {
  width: 60rpx;
  height: 60rpx;
  top: 34rpx;
}

.empty .h2 {
  font-size: 32rpx;
}

.empty-btn {
  margin-top: 24rpx;
  width: 300rpx;
}

.more {
  padding: 32rpx 0;
  text-align: center;
}
