.gallery {
  padding: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 140rpx 40rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 110rpx;
}

.empty-btn {
  width: 50%;
  margin-top: 20rpx;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.wall {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.cell {
  min-width: 0;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow);
}

.cell:active {
  transform: scale(0.98);
}

.cell image,
.cell-empty {
  width: 100%;
  height: 300rpx;
  background: #f6efe9;
}

.cell-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 22rpx;
}

.cell-title {
  display: block;
  padding: 14rpx 18rpx 18rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more {
  padding: 32rpx 0 60rpx;
  text-align: center;
}
