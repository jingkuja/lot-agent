<view class="page gallery">
  <view class="page-heading">
    <text class="eyebrow">我的作品</text>
    <view class="heading-row">
      <text class="h1">留住每一次灵感。</text>
      <view class="new-work" bindtap="goStudio">＋ 创作</view>
    </view>
    <text class="muted">喜欢的画面，都收在这里。</text>
  </view>
  <view wx:if="{{empty}}" class="empty">
    <view class="empty-art">
      <view class="photo-mark"></view>
    </view>
    <text class="h2">第一张作品，等你开始</text>
    <text class="muted">修一张照片，或把脑海里的画面变成图片。</text>
    <view class="btn btn-primary empty-btn" bindtap="goStudio">开始创作 ↗</view>
  </view>
  <block wx:else>
    <view class="collection-bar">
      <text>{{loading ? '正在整理作品…' : '最近创作'}}</text>
      <text>{{items.length}} 件</text>
    </view>
    <view class="wall">
      <view class="cell {{item.generating ? 'cell-generating' : ''}}" wx:for="{{items}}" wx:key="id" data-src="{{item.preview}}" data-title="{{item.title}}" data-generating="{{item.generating}}" bindtap="open">
        <view wx:if="{{item.generating}}" class="cell-busy">
          <view class="generation-grain"></view>
          <view class="generation-grain generation-grain-secondary"></view>
          <text class="generation-progress cell-progress">{{item.progress || 0}}%</text>
          <text class="generation-status cell-status">{{item.statusText || '正在生成'}}</text>
        </view>
        <block wx:else>
          <image wx:if="{{item.preview}}" src="{{item.preview}}" mode="aspectFill" lazy-load />
          <view wx:else class="cell-empty">画面准备中</view>
        </block>
        <view class="cell-caption">
          <text class="cell-title">{{item.title || '未命名作品'}}</text>
          <text class="cell-arrow">{{item.generating ? '···' : '↗'}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{nextCursor}}" class="more" bindtap="loadMore">
      <text class="muted">{{loading ? '加载中…' : '查看更多作品 ↓'}}</text>
    </view>
  </block>
</view>
