<view class="page gallery">
  <view wx:if="{{empty}}" class="empty">
    <view class="empty-emoji">🖼️</view>
    <text class="h2">还没有作品</text>
    <text class="muted">去「修图」或「海报」做一张,会出现在这里</text>
    <view class="btn btn-primary empty-btn" bindtap="goStudio">去创作</view>
  </view>

  <block wx:else>
    <view class="head">
      <text class="h2">我的作品</text>
      <text class="muted">{{items.length}} 张</text>
    </view>

    <view class="wall">
      <view
        class="cell"
        wx:for="{{items}}"
        wx:key="id"
        data-src="{{item.preview}}"
        data-title="{{item.title}}"
        bindtap="open"
      >
        <image wx:if="{{item.preview}}" src="{{item.preview}}" mode="aspectFill" />
        <view wx:else class="cell-empty">生成中…</view>
        <text class="cell-title">{{item.title}}</text>
      </view>
    </view>

    <view wx:if="{{nextCursor}}" class="more" bindtap="loadMore">
      <text class="muted">加载更多</text>
    </view>
  </block>
</view>
