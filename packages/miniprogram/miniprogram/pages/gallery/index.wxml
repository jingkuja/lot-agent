<view class="page gallery">
  <view wx:if="{{empty}}" class="empty">
    <view class="empty-emoji">🖼️</view>
    <text class="h2">还没有作品</text>
    <text class="muted">去「修图」或「海报」做一张,会出现在这里</text>
    <view class="btn btn-primary empty-btn" bindtap="goStudio">去创作</view>
  </view>

  <block wx:else>
    <view class="head">
      <text class="h2">我的作品</text>
      <text class="muted">{{items.length}} 张</text>
    </view>

    <view class="wall">
      <view
        class="cell {{item.generating ? 'cell-generating' : ''}}"
        wx:for="{{items}}"
        wx:key="id"
        data-src="{{item.preview}}"
        data-title="{{item.title}}"
        data-generating="{{item.generating}}"
        bindtap="open"
      >
        <block wx:if="{{item.generating}}">
          <view class="cell-busy">
            <view class="dots">
              <view class="dot dot-1"></view>
              <view class="dot dot-2"></view>
              <view class="dot dot-3"></view>
              <view class="dot dot-4"></view>
              <view class="dot dot-5"></view>
            </view>
            <text class="cell-progress">{{item.progress || 0}}%</text>
            <text class="cell-status">{{item.statusText || '正在生成'}}</text>
          </view>
        </block>
        <block wx:else>
          <image wx:if="{{item.preview}}" src="{{item.preview}}" mode="aspectFill" />
          <view wx:else class="cell-empty">生成中…</view>
        </block>
        <text class="cell-title">{{item.title}}</text>
      </view>
    </view>

    <view wx:if="{{nextCursor}}" class="more" bindtap="loadMore">
      <text class="muted">加载更多</text>
    </view>
  </block>
</view>
